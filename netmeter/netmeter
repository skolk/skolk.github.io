    # table and, worse, two identities the enforcement has to agree about: the
    # throttle held "Claude" (whose command-line regex catches the helpers) while
    # the sweep saw six stopped processes filed under "Claude Helper", which no
    # record claimed, and woke them once a minute. Folding is the fix Cursor and
    # Chrome already had.
    (re.compile(r"^Claude Helper"), "Claude"),
    (re.compile(r"^Granola Helper"), "Granola"),
    (re.compile(r"^Signal Helper"), "Signal"),
    (re.compile(r"^Google Chrome"), "Google Chrome"),
    (re.compile(r"^com\.apple\.Web"), "Safari (WebKit)"),
    (re.compile(r"^networkservicep"), "networkserviceproxy (Apple relay)"),
