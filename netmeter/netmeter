#!/usr/bin/env python3
"""netmeter — per-app daily network totals for macOS (the monitoring half of Little Snitch/TripMode).

A small daemon samples `nettop` every few seconds, computes per-process deltas,
and accumulates them into per-app daily totals that survive process exits.
Data lives in ~/.netmeter/YYYY-MM-DD.json.

Usage:
  netmeter                show today's per-app totals and the session line
  netmeter show DATE      show a past day (YYYY-MM-DD)
  netmeter session        show per-app totals for the current session
  netmeter session reset  start a new session (e.g. when switching to tethering)
  netmeter pause APP      freeze an app (SIGSTOP) — e.g. `netmeter pause chrome`
  netmeter resume APP     unfreeze it (SIGCONT)
  netmeter throttle APP   slow an app to a share of its speed instead of freezing it,
                          e.g. `netmeter throttle claude --pct 25`. `throttle APP off`
                          lifts one, `throttle off` lifts all, bare `throttle` lists them
  netmeter status APP     throttled / paused / running / not running
  netmeter pause-all      slow every app that is not protected to a trickle and hold
                          it there, and keep catching anything that wakes up, until
                          you switch apps back on one at a time (each `resume APP`
                          adds it to the allow list). Nothing is frozen: the apps
                          stay alive and usable, just slow
  netmeter pause-all hard the second press. Freezes everything Pause All is holding
                          (SIGSTOP), so their windows go unresponsive.
                          `pause-all soft` goes back to the trickle
  netmeter pause-all off  lift the mode. So does `resume-all`
  netmeter paused         what is frozen or throttled, and why
  netmeter log            netmeter's own error log (~/.netmeter/netmeter.log)
  netmeter lowdata on     freeze the apps in config's lowdata_apps and keep them frozen,
                          throttle the apps in lowdata_throttle to throttle_pct,
                          freeze any app that moves burst_cap_mb inside one minute;
                          notify every notify_every_mb MB of session data
  netmeter lowdata off    lift low data mode and unfreeze
  netmeter profile-here NAME
                          pin the current lowdata settings (mode, freeze list,
                          throttle list, pct, burst cap) to this network, identified
                          by its gateway MAC: joining it applies them by itself,
                          leaving it restores what they replaced. A mode flipped by
                          hand while connected stands until you leave and rejoin
  netmeter profile        list per-network profiles; `profile rm NAME` forgets one
  netmeter networks       list the networks the daemon remembers. Each one
                          remembers whether Low Data and Pause All were on
                          there, written as you flip them, so rejoining brings
                          the modes back. What those modes *do* (the app lists,
                          the percentage, the cap) stays global and does not
                          travel; an explicit profile is the way to pin that to
                          a network. `networks name MAC LABEL` names one,
                          `networks rm NAME|MAC` forgets one, `networks on|off`
                          toggles the remembering itself
  netmeter recent [MIN]   who spent the data over the last MIN minutes (default 60)
  netmeter display        menu bar display options: --rate on|off (live speed),
                          --total on|off (session total), --combine on|off (merge
                          the down and up rates). With both rate and total off the
                          bar item is just an up/down arrow
  netmeter start          run the sampling daemon in the foreground (launchd runs this)
  netmeter reset          zero out today's counters and the session

Config: ~/.netmeter/config.json
  {"lowdata_apps": ["chrome"], "lowdata_throttle": ["claude"], "throttle_pct": 25,
   "burst_cap_mb": 150, "notify_every_mb": 25,
   "network_profiles": {"<gateway MAC>": {"name": "...", "settings": {...}}}}
"""

import argparse
import atexit
import contextlib
import datetime
import fcntl
import json
import os
import re
import signal
import subprocess
import sys
import threading
import time
import traceback

# Decimal units, deliberately. A carrier that sells a 50 GB plan means
# 50 x 10^9 bytes, so counting the cap in 2^30 gave 7.4% of phantom headroom:
# the "100% used" warning did not fire until roughly 3.7 GB past the real cap.
# Display follows the same units so the bar and the bill agree. (2026-08-19)
KB, MB, GB = 1000, 1000 ** 2, 1000 ** 3

STATE_DIR = os.path.expanduser("~/.netmeter")
NOW_PATH = os.path.join(STATE_DIR, "now.json")
SESSION_PATH = os.path.join(STATE_DIR, "session.json")
PAUSED_PATH = os.path.join(STATE_DIR, "paused.json")
THROTTLED_PATH = os.path.join(STATE_DIR, "throttled.json")
RECENT_PATH = os.path.join(STATE_DIR, "recent.jsonl")
TETHER_PATH = os.path.join(STATE_DIR, "tether.json")
PROFILE_PATH = os.path.join(STATE_DIR, "profile.json")
NETWORKS_PATH = os.path.join(STATE_DIR, "networks.json")
CONFIG_PATH = os.path.join(STATE_DIR, "config.json")
RAMP_PATH = os.path.join(STATE_DIR, "ramping.json")
UPDATE_PREFS_PATH = os.path.join(STATE_DIR, "update_prefs.json")
LOG_PATH = os.path.join(STATE_DIR, "netmeter.log")
LOG_MAX = 512 * 1000       # one rollover to netmeter.log.1, then overwrite

# lowdata_apps is empty by default: low data mode only watches and notifies.
# Add "chrome" (or any alias/pattern) to also freeze apps while the mode is on.
# Metered network: all personal values (name, cap, reset day, linked gateways)
# live in ~/.netmeter/config.json, set via `netmeter tether-config` and
# `netmeter tether-here`. The defaults here are deliberately empty.
DEFAULT_CONFIG = {
    # Bumped when a migration has to run once over the state files. 2: solo
    # mode retired into Pause All (2026-08-28).
    "config_version": 2,
    # enforce: the master switch under every hold. False is monitor only: the
    # meter keeps counting and notifying, and nothing is ever frozen, throttled
    # or capped, whatever the modes say, until it goes back to True.
    "enforce": True,
    # burst_cap_on: the switch in front of both caps, so the size stays put
    # while the cap is off. Asked for 2026-09-04: Low Data read off while the
    # cap, armed by the metered network, kept freezing apps, and there was no
    # way to turn that off short of editing config.json.
    "burst_cap_on": True,
    "lowdata": False, "lowdata_apps": [], "notify_every_mb": 25,
    # lowdata_throttle is the middle setting between "leave it alone" and the
    # all-or-nothing freeze of lowdata_apps: apps here stay usable, just slow.
    # throttle_period is the duty cycle length in seconds; longer saves more
    # syscalls, shorter keeps a stalled TCP connection from backing off.
    "lowdata_throttle": [], "throttle_pct": 25, "throttle_period": 4.0,
    # burst_cap_mb is the hard stop, and it is the one that protects a monthly
    # cap. Throttling is a soft brake: a stopped process still has its socket
    # buffer filled for it by the kernel and drains the backlog the moment it
    # wakes, so a 25% duty cycle measured 63% of full speed against a real
    # transfer. Freezing an app that has moved burst_cap_mb inside one minute is
    # what actually stops a bulk download. Only armed while low data mode is on.
    "burst_cap_mb": 0,
    # pause_all is the blunt one: freeze everything, then switch back on what
    # you actually need. pause_all_allow is that growing list of exceptions,
    # written by `resume APP` while the mode is on. Enforced every tick, so an
    # app that launches later is frozen the moment it reaches for the network.
    "pause_all": False, "pause_all_allow": [],
    # Pause All lands on a hold, not a freeze: everything drops to
    # PAUSE_ALL_FLOOR% of its duty cycle and stays there, slow enough to save
    # the data and alive enough that the editor you are working in keeps
    # working. Hard Stop is the deliberate second press that lands the freeze.
    # The mode froze outright until 2026-08-28, and the first thing it froze was
    # Cursor mid-session. Not remembered per network (see MEMORY_KEYS): a hold
    # is a reasonable thing to walk back into, a frozen machine is not.
    "pause_all_hard": False,
    # A freeze is a blunt landing: SIGSTOP mid-transfer strands the request, and
    # mid-save it strands worse. The ramp spends a few seconds slowing an app
    # towards the stop instead, at 25% of its duty cycle and then 5%, and waits
    # for it to go quiet before pulling the plug. `ramp_seconds` is when the
    # first freeze is attempted, the 5% step lands at half of it, `ramp_max` is
    # the deadline after which a still-busy app is frozen anyway, and
    # `ramp_quiet_kb` is what counts as quiet in one tick.
    "ramp": True, "ramp_seconds": 8.0, "ramp_max": 30.0, "ramp_quiet_kb": 50,
    # Low Data is the tethering mode, and on a hotspot the traffic nobody asked
    # for is the expensive kind: a macOS update, an App Store download, iCloud
    # catching up, an editor fetching a release. Two levers, both only while
    # Low Data is on. lowdata_background freezes the daemons that fetch (see
    # BACKGROUND_DOWNLOADS); update_prefs flips the documented auto-update
    # preferences so the polite ones do not even ask, and puts them back after.
    "lowdata_background": True, "update_prefs": True,
    # The slow bleed a per-minute cap cannot see: 30 MB a minute for ten minutes
    # never trips a 50 MB/min cap and still costs 300 MB. Off by default; set it
    # to arm it. Armed under the same condition as the burst cap.
    "drain_cap_mb": 0, "drain_window_min": 5,
    # remember_networks: every network the daemon sees gets the position of its
    # mode switches (Low Data, Pause All) written to networks.json as they
    # change, and rejoining a remembered network brings them back. Only the
    # switches: see MEMORY_KEYS for why the settings behind them stay global.
    # Explicit profiles in network_profiles still win where both exist.
    "remember_networks": True,
    "combine_updown": False, "show_rate": True, "show_total": True,
    # apps_view: how much of the per-app list the bar shows, "min" (3), "some"
    # (6) or "all" (20). apps_open is the older two-state key, still read once
    # so an existing config lands somewhere sensible.
    "recent_window": 60, "recent_open": True, "apps_view": "some",
    "tether_name": "", "tether_cap_gb": 0, "tether_reset_day": 1,
    # tether_linked: the day the link was made, so the "nothing counted" check
    # ages from the link rather than from a period that predates it.
    "tether_gateway_macs": [], "tether_linked": "", "wifi_if": "en0",
    # network_profiles pins lowdata settings to a network, keyed by gateway MAC,
    # the identity the tether counter already trusts (reading the SSID needs
    # location permission, the router's MAC does not). Entries are
    # {"name": ..., "settings": {PROFILE_KEYS...}}, made by `profile-here`.
    "network_profiles": {},
}

# Where Pause All's soft stage parks an app: 5% of the duty cycle, which is the
# bottom step the ramp already uses, so the hold is the ramp arriving rather
# than a second number that can disagree with it.
PAUSE_ALL_FLOOR = 5

