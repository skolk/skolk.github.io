            changes["combine_updown"] = args.combine == "on"
        if args.rate is not None:
            changes["show_rate"] = args.rate == "on"
        if args.total is not None:
            changes["show_total"] = args.total == "on"
        if args.recent_window is not None:
            changes["recent_window"] = max(1, min(720, args.recent_window))
        if args.recent_open is not None:
            changes["recent_open"] = args.recent_open == "on"
        if args.apps_view is not None:
            changes["apps_view"] = args.apps_view
        if args.apps_open is not None:
            changes["apps_view"] = "all" if args.apps_open == "on" else "some"
        cfg = update_config(**changes) if changes else load_config()
        shown = []
        if cfg["show_rate"]:
            shown.append("one combined rate (\u21c5)" if cfg["combine_updown"]
                         else "separate \u2193 and \u2191")
        if cfg["show_total"]:
            shown.append("session total")
        print("Menu bar: " + (", ".join(shown) if shown
                              else "arrow only (\u21c5), both readouts hidden"))
    elif args.cmd == "recent":
        show_recent(args.minutes)
    elif args.cmd == "resume-all":
        resume_all()
    elif args.cmd == "pause-all":
        pause_all(args.action)
    elif args.cmd == "paused":
        show_paused(args.jobs)
    elif args.cmd == "log":
        show_log(args.n)
    elif args.cmd == "tether-config":
        changes = {}
        if args.name is not None:
            changes["tether_name"] = args.name
        if args.cap is not None:
            changes["tether_cap_gb"] = args.cap
        if args.reset_day is not None:
            changes["tether_reset_day"] = max(1, min(28, args.reset_day))
        if args.notify_mb is not None:
            changes["notify_every_mb"] = args.notify_mb
        if args.combine is not None:
            changes["combine_updown"] = args.combine == "on"
        if args.rate is not None:
            changes["show_rate"] = args.rate == "on"
        if args.total is not None:
            changes["show_total"] = args.total == "on"
        cfg = update_config(**changes)
        print(f"Metered network: {cfg.get('tether_name') or '(unnamed)'} · "
              f"{cfg.get('tether_cap_gb') or 0} GB/month · resets on day "
              f"{cfg.get('tether_reset_day', 1)}. Link the network itself with "
              f"`netmeter tether-here` while connected to it.")
    elif args.cmd == "tether-link":
        # The other half of tether-here. `tether-here` needs you standing on the
        # network, which is exactly where you are not when you notice the cap
        # has counted nothing for three weeks. Anything memory has seen can be
        # linked from anywhere, and memory has seen every network worth linking.
        cfg = load_config()
        nets = read_json(NETWORKS_PATH) or {}
        if not args.which:
            found = tether_candidate(cfg, cfg.get("tether_gateway_macs") or [], nets)
            print("Usage: netmeter tether-link NAME|MAC")
            if found:
                print(f"  Looks like you mean: {found[1].get('name')} "
                      f"({found[0]}, router {found[1].get('router', '?')}, "
                      f"last seen {found[1].get('last_seen', '?')})")
            print("  `netmeter networks` lists what is remembered; "
                  "`networks name MAC LABEL` names one first.")
            return
        want, key = mac_norm(args.which), _name_key(args.which)
        hits = [m for m, e in nets.items()
                if mac_norm(m) == want or _name_key(e.get("name") or "") == key]
        if not hits:
            print(f"No remembered network '{args.which}'. "
                  f"`netmeter networks` lists them.")
            return
        if len(hits) > 1:
            print(f"'{args.which}' matches {len(hits)} networks. "
                  f"Use the MAC: {', '.join(hits)}")
            return
        mac = hits[0]
        macs = [m for m in (cfg.get("tether_gateway_macs") or [])
                if mac_norm(m) != mac_norm(mac)]
        # Replace rather than append. A stale link is not a second tether, it is
        # the same one under an address the phone has stopped using, and leaving
        # it in means a cap that counts whoever inherits that MAC next.
        e = nets[mac]
        cfg = update_config(tether_gateway_macs=[mac],
                            tether_linked=datetime.date.today().isoformat())
        dropped = f" (dropped {len(macs)} stale link(s))" if macs else ""
        print(f"Linked {e.get('name') or mac} (MAC {mac}, router "
              f"{e.get('router', '?')}) as {cfg.get('tether_name')}"
              f"{dropped}. Its traffic counts against the "
              f"{cfg.get('tether_cap_gb')} GB cap from the next tick on it.")
        print("  The counter does not backfill: this period's total starts from "
              "what it has, which is why `tether --used-gb N` exists.")
    elif args.cmd == "tether-forget":
        update_config(tether_gateway_macs=[])
        print("Unlinked all metered networks.")
    elif args.cmd == "tether":
        cfg = load_config()
        if not cfg.get("tether_name") and not cfg.get("tether_cap_gb"):
            print("No metered network configured. Set one with:")
            print("  netmeter tether-config --name <network> --cap <GB> --reset-day <day>")
            print("  netmeter tether-here   (run once while connected to it)")
            return
        t = load_tether(cfg)
        if args.used_gb is not None:
            t["in"], t["out"], t["notified_pct"] = int(args.used_gb * GB), 0, 0
            save_json(TETHER_PATH, t)
            print(f"Seeded the period at {args.used_gb} GB.")
        used = t["in"] + t["out"]
        cap_gb = cfg.get("tether_cap_gb", 0)
        nr = tether_next_reset(datetime.date.fromisoformat(t["period_start"]))
        days = (nr - datetime.date.today()).days
        _, gw = gateway_mac(cfg.get("wifi_if", "en0"))
        macs = cfg.get("tether_gateway_macs") or []
        if not macs:
            state_txt = "not linked yet: run `netmeter tether-here` while tethered"
        elif gw in macs:
            state_txt = "connected, counting"
        else:
            state_txt = "not on the tether network"
        warn = tether_link_warning(cfg, macs, t, gw in macs)
        pct = f" ({100 * used / (cap_gb * GB):.0f}%)" if cap_gb else ""
        print(f"{cfg.get('tether_name')}: {fmt(used)} of {cap_gb} GB{pct} · "
              f"resets {nr.isoformat()} ({days} days) · {state_txt}")
        if warn:
            print(f"  warning: {warn}")
            print("  A phone hands out a new gateway MAC when its hotspot is "
                  "re-created, and the cap counts nothing until the new one is "
                  "linked.")
            found = tether_candidate(cfg, macs)
            if found:
                print(f"  Memory has one that fits: {found[1].get('name')} "
                      f"(router {found[1].get('router', '?')}, last seen "
                      f"{found[1].get('last_seen', '?')}). Link it from here "
                      f"with:\n    netmeter tether-link {found[1].get('name')}")
            else:
                print("  Run `netmeter tether-here` while on it, or "
                      "`netmeter tether-link NAME` for one memory already knows.")
        # Who spent it. The line above is the bill; this is the reason for it.
        apps = t.get("apps") or {}
        if apps:
            print()
            print_table(apps, f"Who spent it, since {t['period_start']}:",
                        top=args.top or None)
            print("  Per-app numbers are payload bytes seen by the sampler and "
                  "run 10-15% under the")
            print("  header, which counts every byte on the interface. The "
                  "header is the bill; this")
            print("  table is who to talk to about it.")
        elif macs:
            print("  (No per-app tally yet for this period. Attribution starts "
                  "the first tick on the network; there is no backfill.)")
    elif args.cmd == "tether-here":
        cfg = load_config()
        ip, gw = gateway_mac(cfg.get("wifi_if", "en0"))
        if not gw:
            print("Could not read the gateway MAC. Are you on wi-fi?")
        else:
            macs = cfg.get("tether_gateway_macs") or []
            if gw not in macs:
                macs.append(gw)
            cfg = update_config(tether_gateway_macs=macs,
                                tether_linked=datetime.date.today().isoformat())
            print(f"Linked this network (router {ip}, MAC {gw}) as "
                  f"{cfg.get('tether_name')}. Its traffic now counts against the "
                  f"{cfg.get('tether_cap_gb')} GB cap.")
    elif args.cmd == "reset":
        today = datetime.date.today().isoformat()
        for path in (state_path(today), SESSION_PATH):
            try:
                os.remove(path)
            except FileNotFoundError:
                pass
        print(f"Reset counters and session for {today}.")
    else:
        show(datetime.date.today().isoformat())


