    elif args.cmd == "profile-here":
        profile_here(args.name)
    elif args.cmd == "profile":
        profile_cmd(args.action, args.name)
    elif args.cmd == "networks":
        networks_cmd(args.action, args.name, args.label)
    elif args.cmd == "solo":
        # Retired into Pause All, which is the same idea without the cap of one.
        app = args.app if args.app and args.app != "off" else "APP"
        print("`solo` retired 2026-08-28. Pause All is the same thing with room "
              "for more than one app:\n"
              "  netmeter pause-all\n"
              f"  netmeter resume {app}      (once per app you want through)\n"
              "  netmeter resume-all        (lift it)")
