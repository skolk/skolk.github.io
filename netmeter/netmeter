# Short names accepted by pause/resume/lowdata, mapped to pgrep -f patterns.
ALIASES = {
    "chrome": "Google Chrome",
    "safari": "Safari",
    "cursor": "Cursor",
    "spotify": "Spotify",
    "slack": "Slack",
    "whatsapp": "WhatsApp",
}


def friendly(name):
    for pat, label in FRIENDLY:
        if pat.match(name):
            return label
    return name


def state_path(date):
    return os.path.join(STATE_DIR, f"{date}.json")


def log(msg, exc=False):
    """netmeter's own error log, ~/.netmeter/netmeter.log.

    launchd captures stdout and stderr per process, so the daemon's crashes
    landed in daemon.log and the bar's in bar.log, while a CLI run from a shell
    wrote its traceback to a terminal nobody kept. The three tracebacks that
    sat unread in bar.log for a week are the argument for one file both halves
    write to and `netmeter log` reads back. Never raises: a logger that can
    take the daemon down is worse than no logger."""
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        stamp = datetime.datetime.now().isoformat(timespec="seconds")
        line = f"{stamp} [{os.getpid()}] {msg}"
        if exc:
            line += "\n" + traceback.format_exc().rstrip()
        with open(LOG_PATH, "a") as f:
            f.write(line + "\n")
        if os.path.getsize(LOG_PATH) > LOG_MAX:
            os.replace(LOG_PATH, LOG_PATH + ".1")
    except Exception:
        pass


def show_log(n):
    """Tail of the internal log, plus a pointer at the launchd-captured ones."""
    lines = []
    for path in (LOG_PATH + ".1", LOG_PATH):
        try:
            with open(path) as f:
                lines.extend(f.readlines())
        except FileNotFoundError:
            pass
    if not lines:
        print(f"{LOG_PATH} is empty. Nothing has gone wrong since it was last cleared.")
    else:
        sys.stdout.write("".join(lines[-n:]))
    print(f"\n(daemon stdout: {STATE_DIR}/daemon.log \u00b7 bar stderr: {STATE_DIR}/bar.log)")


def save_json(path, obj):
    """The temp name carries the pid. A shared `<path>.tmp` is what let two
    netmeter processes writing at the same moment interleave into an
    unparseable config.json, which read_json then swallowed, which made the
    next load_config() fall back to defaults and persist them: one Preferences
    Save wiped a linked tether network. Found 2026-08-19."""
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f)
    os.replace(tmp, path)


@contextlib.contextmanager
def locked(path):
    """Exclusive lock for a read-modify-write. The daemon and the CLI both edit
    config.json and paused.json, and an unlocked read-modify-write loses the
    other writer's change even when each individual write is atomic."""
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(path + ".lock", "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)


def update_config(_drop=(), **changes):
    """The only way config.json is written. Locked, and it refuses to answer a
    corrupt file with a fresh set of defaults: it recovers from config.json.bak
    and says so, because silently defaulting is what turned a transient race
    into lost settings. `_drop` names keys to delete, which only a migration
    has ever needed: a retired setting left lying in the file is a fact about
    the tool that stopped being true."""
    with locked(CONFIG_PATH):
        raw, note = {}, ""
        if os.path.exists(CONFIG_PATH):
            try:
                with open(CONFIG_PATH) as f:
                    raw = json.load(f)
            except json.JSONDecodeError:
                os.replace(CONFIG_PATH, CONFIG_PATH + ".corrupt")
                raw = read_json(CONFIG_PATH + ".bak") or {}
                note = (f" (config.json was unreadable, kept as config.json.corrupt; "
                        f"recovered {'from config.json.bak' if raw else 'defaults'})")
        cfg = dict(DEFAULT_CONFIG)
        cfg.update(raw)
        cfg.update(changes)
        for key in _drop:
            cfg.pop(key, None)
        save_json(CONFIG_PATH, cfg)
        with contextlib.suppress(OSError):
            save_json(CONFIG_PATH + ".bak", cfg)
        if note:
            print("netmeter:" + note)
        return cfg


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return None


def load(date):
    d = read_json(state_path(date)) or {
        "date": date, "started": None, "updated": None, "apps": {}}
    # Per-network totals live in the day file rather than a file of their own.
    # They rotate for free that way, they answer "today" without a second
    # period concept to keep in step with the first, and every past day keeps
    # its own breakdown instead of one running figure that forgets.
    d.setdefault("nets", {})
    return d


RECENT_KEEP = 800          # minutes of history, a little over 13 hours


def append_recent(minute, apps):
    """One JSON object per line, one line per elapsed minute. Appending is O(1),
    which is why this is not the single rewritten blob the rest of the state
    uses: a rewrite every tick would be writing hundreds of KB a minute to keep
    a few dozen numbers."""
    if not apps:
        return
    with locked(RECENT_PATH):
        with open(RECENT_PATH, "a") as f:
            f.write(json.dumps({"m": minute, "a": apps}, separators=(",", ":")) + "\n")


def prune_recent():
    with locked(RECENT_PATH):
        try:
            with open(RECENT_PATH) as f:
                lines = f.readlines()
        except FileNotFoundError:
            return
        if len(lines) <= RECENT_KEEP * 2:
            return
        tmp = f"{RECENT_PATH}.{os.getpid()}.tmp"
        with open(tmp, "w") as f:
            f.writelines(lines[-RECENT_KEEP:])
        os.replace(tmp, RECENT_PATH)


def read_recent(window_minutes):
    """Per-app totals over the last `window_minutes` complete minutes."""
    cutoff = int(time.time() // 60) - window_minutes
    totals = {}
    try:
        with open(RECENT_PATH) as f:
            for line in f:
                try:
                    row = json.loads(line)
                except json.JSONDecodeError:
                    continue          # a torn final line, skip it
                if row.get("m", 0) <= cutoff:
                    continue
                for app, (d_in, d_out) in row.get("a", {}).items():
                    t = totals.setdefault(app, [0, 0])
                    t[0] += d_in
                    t[1] += d_out
    except FileNotFoundError:
        return {}
    return totals


def migrate_state():
    """Bring state on disk up to the current config_version, one step per wave.

    Each step is gated on the version it was written for, so the common case is
    one small read and nothing else."""
    raw = read_json(CONFIG_PATH) or {}
    version = raw.get("config_version", 1)
    if version < 2:
        _migrate_solo(raw)
    if version < 3:
        _migrate_memory_keys()


def _migrate_memory_keys():
    """v3, 2026-08-31: network memory stopped speaking for the preference keys.

    Every entry written before today carries a copy of lowdata_apps,
    lowdata_throttle, throttle_pct and burst_cap_mb as they stood on the last
    visit, and every one of those copies is a stale edit waiting to be restored
    over a current one. Trim them to the switches. Explicit profiles in
    network_profiles are untouched: pinning one is deliberate, and the pin is
    supposed to speak for the whole family."""
    nets = read_json(NETWORKS_PATH) or {}
    trimmed = 0
    for entry in nets.values():
        st = entry.get("settings")
        if not isinstance(st, dict):
            continue
        keep = {k: st[k] for k in MEMORY_KEYS if k in st}
        if keep != st:
            entry["settings"] = keep
            trimmed += 1
    if trimmed:
        save_json(NETWORKS_PATH, nets)
    update_config(config_version=3)
    log(f"migrated config to v3 (network memory -> mode switches only): "
        f"{trimmed} entr{'y' if trimmed == 1 else 'ies'} trimmed")


def _migrate_solo(raw):
    """One-time conversion of anything still carrying solo mode, retired
    2026-08-28 into Pause All. Solo was Pause All with the allow list capped at
    one, so every solo fact has an exact translation: the mode becomes Pause
    All, the soloed app becomes the one entry in the allow list, and a freeze
    solo owned becomes a freeze Pause All owns. Four places carried it, and a
    migration that skipped any one of them would leave a network rejoining into
    a mode that no longer exists.

    Gated on config_version by migrate_state()."""
    changes = {"config_version": 2}
    solo_on, solo_app = bool(raw.get("solo")), raw.get("solo_app") or ""
    if solo_on:
        allow = list(raw.get("pause_all_allow") or [])
        if solo_app and solo_app not in allow:
            allow.append(solo_app)
        changes.update(pause_all=True, pause_all_allow=allow)

    # networks.json: every remembered network's mode settings.
    nets = read_json(NETWORKS_PATH) or {}
    touched = False
    for entry in nets.values():
        st = entry.get("settings")
        if not isinstance(st, dict) or not ({"solo", "solo_app"} & set(st)):
            continue
        was_on, app = bool(st.pop("solo", False)), st.pop("solo_app", "")
        allow = list(st.get("pause_all_allow") or [])
        if was_on and app and app not in allow:
            allow.append(app)
        st["pause_all"] = was_on or bool(st.get("pause_all"))
        st["pause_all_allow"] = allow
        touched = True
    if touched:
        save_json(NETWORKS_PATH, nets)

    # profile.json: the live stint's applied/saved overlay.
    stint = read_json(PROFILE_PATH)
    if stint and any(k in (stint.get(part) or {})
                     for part in ("applied", "saved") for k in ("solo", "solo_app")):
        for part in ("applied", "saved"):
            stint[part] = {k: v for k, v in (stint.get(part) or {}).items()
                           if k not in ("solo", "solo_app")}
        save_json(PROFILE_PATH, stint)

    # paused.json: freezes solo owned become Pause All's, or are lifted if the
    # mode is not carrying over. A freeze whose owner no longer exists would sit
    # there until someone noticed, which is the bug this whole wave was about.
    for name, e in read_paused().items():
        if e["reason"] != "solo":
            continue
        if solo_on:
            set_paused(name, True, "all", e["pids"])
        else:
            signal_pids(e["pids"], signal.SIGCONT)
            signal_app(name, signal.SIGCONT)
            set_paused(name, False)

    update_config(_drop=("solo", "solo_app"), **changes)
    log(f"migrated config to v2 (solo -> pause all): {changes}")


def load_config():
    cfg = dict(DEFAULT_CONFIG)
    cfg.update(read_json(CONFIG_PATH) or {})
    return cfg


def parse_row(line):
    """One nettop CSV row -> (process_name, pid, bytes_in, bytes_out), or None.

    The pid used to be matched and thrown away. It is what lets the throttle
    tell an app's process that is moving bytes from one that is only drawing
    the window (see CARRIERS)."""
    parts = line.split(",")
    if len(parts) < 3:
        return None
    m = re.match(r"^(.+)\.(\d+)$", parts[0])
    if not m:
        return None
    try:
        return m.group(1), int(m.group(2)), int(parts[1]), int(parts[2])
    except ValueError:
        return None


def session_totals(data):
    """Per-app bytes since the last session reset (or since recording began today)."""
    sess = read_json(SESSION_PATH)
    live = sess is not None and sess.get("date") == data["date"]
    snap = sess["snapshot"] if live else {}
    apps = {}
    for app, v in data["apps"].items():
        s = snap.get(app, [0, 0])
        d_in, d_out = max(0, v[0] - s[0]), max(0, v[1] - s[1])
        if d_in or d_out:
            apps[app] = [d_in, d_out]
    started = sess["started"] if live else data["started"]
    return apps, started


def reset_session():
    today = datetime.date.today().isoformat()
    data = load(today)
    save_json(SESSION_PATH, {
        "started": datetime.datetime.now().isoformat(timespec="seconds"),
        "date": today,
        "snapshot": {k: list(v) for k, v in data["apps"].items()},
    })
    print("Session reset. Counting from zero now.")


def canonical(name):
    return ALIASES.get(name.lower(), name)


def gateway_mac(iface):
    """(router_ip, router_mac) of the current network, from DHCP + ARP.
    Works without location permission, unlike reading the SSID."""
    ip = subprocess.run(["ipconfig", "getoption", iface, "router"],
                        capture_output=True, text=True).stdout.strip()
    if not ip:
        return None, None
    arp = subprocess.run(["arp", "-n", ip], capture_output=True, text=True).stdout
    m = re.search(r" at ([0-9a-f:]+)", arp)
    return ip, (m.group(1) if m else None)


def wifi_bytes(iface):
    """Cumulative (in, out) bytes for the interface since boot, from netstat."""
    out = subprocess.run(["netstat", "-ib", "-I", iface],
                         capture_output=True, text=True).stdout
    for line in out.splitlines():
        p = line.split()
        if len(p) >= 11 and p[2].startswith("<Link"):
            return int(p[6]), int(p[9])
    return None


def tether_period_start(reset_day, today=None):
    t = today or datetime.date.today()
    if t.day >= reset_day:
        return datetime.date(t.year, t.month, reset_day)
    prev_last = t.replace(day=1) - datetime.timedelta(days=1)
    return datetime.date(prev_last.year, prev_last.month, reset_day)


def tether_next_reset(period_start):
    y, m = period_start.year, period_start.month + 1
    if m > 12:
        y, m = y + 1, 1
    return datetime.date(y, m, period_start.day)


def load_tether(cfg):
    t = read_json(TETHER_PATH) or {}
    ps = tether_period_start(cfg["tether_reset_day"]).isoformat()
    if t.get("period_start") != ps:
        t = {"period_start": ps, "in": 0, "out": 0, "notified_pct": 0,
             "apps": {}}
        # Persist the rollover here, not only where the counting happens. The
        # write used to live inside the tick's "on the tether" branch, so a
        # period that turned over while off the tether was recomputed in memory
        # every tick and never written: on 2026-08-28 tether.json still read
        # period_start 2026-07-04 with 24.7 GB against it.
        save_json(TETHER_PATH, t)
    t.setdefault("apps", {})      # a file written before attribution shipped
    return t


def net_add(data, mac, d_in, d_out, tick_io, name=""):
    """Charge a tick to the network it happened on, inside the day it happened.

    Totals come off the interface, the same source the cap trusts, because that
    is what a carrier counts. The per-app split comes off nettop, which counts
    payload and so runs 10-15% under. Both are kept: one answers how much, the
    other answers who, and neither can answer the other's question.

    Daily rather than per billing period, which is what this was first built as.
    The period version put a number next to Session and Today that covered a
    different span from either, so a menu could read Today 652 MB and Network
    35 MB and look broken while being correct. Three scopes worth comparing
    have to be three scopes you can compare."""
    if not mac:
        return None
    e = data.setdefault("nets", {}).setdefault(
        mac, {"in": 0, "out": 0, "apps": {}})
    # When this network first cost anything today. The header shows the span
    # next to the number, which on an ordinary day reads as how long you have
    # been on this network, and on the day this shipped is what stops "Today
    # 722 MB / Network 4.8 MB" from looking like a bug. setdefault rather than
    # a branch on the entry being new, so an entry written before the field
    # existed picks one up instead of showing a number with no span at all.
    e.setdefault("since", datetime.datetime.now().isoformat(timespec="seconds"))
    e["in"] += max(0, d_in)
    e["out"] += max(0, d_out)
    if name:
        e["name"] = name
    apps = e.setdefault("apps", {})
    for label, (a_in, a_out) in (tick_io or {}).items():
        a = apps.setdefault(label, [0, 0])
        a[0] += a_in
        a[1] += a_out
    return e


def net_totals(data):
    """{mac: bytes} for a day, biggest first, so the caller does not re-derive
    the sort every time it wants to say which network cost the most."""
    tot = {m: e.get("in", 0) + e.get("out", 0)
           for m, e in (data.get("nets") or {}).items()}
    return dict(sorted(tot.items(), key=lambda kv: -kv[1]))


def tether_attribute(tether, tick_io):
    """Add this tick's per-app bytes to the period's tether tally.

    The counter above this one answers "how much", off the interface, which is
    what the carrier bills. It cannot answer "who": interface bytes have no
    process attached to them. This is the other half, accumulated from the same
    nettop rows the daily file uses, kept per billing period and thrown away
    with the rest of the period at rollover.

    The two do not agree, and are not meant to: nettop counts payload and the
    interface counts payload plus headers plus everything netmeter's sampler
    never sees, so the table runs 10-15% under the header. The header is the
    number to trust against the bill; the table is the number to act on."""
    apps = tether.setdefault("apps", {})
    for label, (d_in, d_out) in tick_io.items():
        a = apps.setdefault(label, [0, 0])
        a[0] += d_in
        a[1] += d_out
    return tether


def mac_norm(mac):
    """A gateway MAC with every octet two digits. `arp` prints 30:23:3:fd:a6:f1
    and 30:23:03:fd:a6:f1 for the same address depending on where it came from,
    and a link stored in one form never matches memory stored in the other."""
    try:
        return ":".join(f"{int(p, 16):02x}" for p in str(mac).split(":"))
    except (ValueError, AttributeError):
        return str(mac)


def _name_key(s):
    return "".join(c for c in str(s).lower() if c.isalnum())


def tether_candidate(cfg, macs, nets=None):
    """The remembered network a broken link most likely meant, or None.

    A phone that re-creates its hotspot hands out a new gateway MAC, and the
    old advice ("relink while tethered") is only actionable in the one place
    you are least likely to be reading it. Memory usually already knows the
    answer: the network is in networks.json under the name it was given, and
    the metered network has a name too. Matching those is enough to name a
    candidate and hand over the command, which `tether-link` can then apply
    from anywhere. Deliberately name-based: guessing from the shape of a MAC
    would be cleverer and wrong the first time a hotspot did not randomise."""
    nets = read_json(NETWORKS_PATH) if nets is None else nets
    linked = {mac_norm(m) for m in macs}
    want = _name_key(cfg.get("tether_name") or "")
    if not want:
        return None
    for mac, e in sorted((nets or {}).items(),
                         key=lambda kv: kv[1].get("last_seen", ""), reverse=True):
        if mac_norm(mac) in linked:
            return None            # the link is fine; nothing to suggest
        have = _name_key(e.get("name") or "")
        if have and (have in want or want in have):
            return mac, e
    return None


def tether_link_warning(cfg, macs, tether, on_it):
    """Why a tether counter reading zero might be lying.

    The cap is linked to a gateway MAC, and a phone that re-creates its hotspot
    hands out a new one. When that happened the counter simply stopped counting:
    `tether` reported 0 KB of 50 GB and "not on the tether network", which is
    also what it says when you are sitting at home, so nothing looked wrong for
    three weeks. Says so out loud now. Kept short because the bar shows it too,
    and one long line in a menu sets the width of the whole menu."""
    if on_it or not macs:
        return ""
    nets = read_json(NETWORKS_PATH) or {}
    known = {mac_norm(m) for m in nets}
    if not any(mac_norm(m) in known for m in macs):
        found = tether_candidate(cfg, macs, nets)
        if found:
            # Short on purpose: the bar shows this line, and one long line in a
            # menu sets the width of the whole menu.
            return f"linked network never seen; try tether-link {found[1]['name']}"
        return "linked network never seen; relink while tethered"
    # Age from the later of the period start and the day the link was made. A
    # link made this morning cannot be blamed for a period that started three
    # weeks ago: relinking used to clear "linked network never seen" and then
    # immediately raise "nothing counted in 27 days", which is true, unfixable,
    # and points at the thing you just fixed. It would have sat there until the
    # period rolled over.
    try:
        since = datetime.date.fromisoformat(tether["period_start"])
    except (KeyError, ValueError):
        return ""
    linked = cfg.get("tether_linked")
    if linked:
        with contextlib.suppress(ValueError):
            since = max(since, datetime.date.fromisoformat(linked))
    age = (datetime.date.today() - since).days
    if age >= 2 and tether["in"] + tether["out"] == 0:
        return f"nothing counted in {age} days; relink while tethered"
    return ""


def ps_ucomm():
    """(pid, ucomm) for every process. ucomm is the short accounting name, the
    same one nettop reports and the only one `pgrep -x` matches against."""
    out = subprocess.run(["ps", "-axo", "pid=,ucomm="],
                         capture_output=True, text=True).stdout
    rows = []
    for line in out.splitlines():
        pid, _, ucomm = line.strip().partition(" ")
        if pid.isdigit():
            rows.append((int(pid), ucomm.strip()))
    return rows


def ps_tty_ucomm():
    """(pid, tty, ucomm) for every process, in one `ps`. The tty is `??` for a
    process no terminal owns, which is every process netmeter is built to hold."""
    out = subprocess.run(["ps", "-axo", "pid=,tty=,ucomm="],
                         capture_output=True, text=True).stdout
    rows = []
    for line in out.splitlines():
        f = line.split(None, 2)
        if len(f) == 3 and f[0].isdigit():
            rows.append((int(f[0]), f[1], f[2].strip()))
    return rows


ERE_META = set(r".[]{}()\\*+?|^$")


def ere_quote(s):
    """Escape a label for pgrep's extended regex. 'networkserviceproxy (Apple
    relay)' is a real label and its parentheses are a capture group unless
    they are escaped, which made the pattern match nothing at all."""
    return "".join("\\" + c if c in ERE_META else c for c in s)


def app_pattern(label):
    """The command-line regex for an app label.

    A bare `pgrep -f Signal` matches any command line containing the word, and
    on 2026-08-28 that meant a burst-cap freeze aimed at Signal the messenger
    left `/Applications/WiFi Signal.app/.../WiFi Signal` stopped for four days.
    So the label has to sit on a path boundary: preceded by a slash or the start
    of the line, and followed by end-of-word rather than more letters. The
    trailing half matters as much as the leading one, because `(^|/)Cursor`
    alone still swept in Apple's CursorUIViewService, an XPC service the text
    input system needs."""
    return f"(^|/){ere_quote(label)}([ ./-]|$)"


def app_pids(name):
    """Match by exact process name AND by command line, so both an app's main
    process (e.g. 'Granola') and its helpers ('Granola Helper') are caught.

    Labels that exist only because FRIENDLY renamed something need that regex
    run in reverse, else the table shows an app the signals cannot reach. The
    Claude Code CLI is the case in point: its process name is its version, so
    `pgrep -x "Claude Code"` matches nothing at all and `pgrep -f claude` would
    sweep in every helper of the desktop app instead."""
    pattern = canonical(name)
    pids = set()
    for args in (["-x", pattern], ["-f", app_pattern(pattern)]):
        out = subprocess.run(["pgrep"] + args, capture_output=True, text=True).stdout
        pids.update(int(p) for p in out.split())
    for pat, label in FRIENDLY:
        if label == pattern:
            pids.update(pid for pid, ucomm in ps_ucomm() if pat.match(ucomm))
    pids -= {os.getpid(), os.getppid(), 1}
    return sorted(pids)


def read_paused():
    """paused.json normalized to {app: {"reason", "pids", "at"}}.

    The pid list is new. Without it nothing could tell a still-frozen app from
    one that was force-quit and relaunched, which is how paused.json came to
    list Chrome, Cursor and Claude as frozen while all three were plainly
    running. Older files stored a bare reason string, older ones still a bare
    `true`; both still read."""
    raw = read_json(PAUSED_PATH) or {}
    out = {}
    for name, v in raw.items():
        if isinstance(v, dict):
            out[name] = {"reason": v.get("reason", "manual"),
                         "pids": [int(x) for x in v.get("pids", [])],
                         "at": float(v.get("at", 0))}
        elif v:
            out[name] = {"reason": v if isinstance(v, str) else "manual",
                         "pids": [], "at": 0.0}
    return out


def set_paused(name, val, reason="manual", pids=None):
    """paused.json maps app -> {reason, pids, at}. The reason is what lets
    `lowdata off` unfreeze exactly what low data froze and nothing else; the pids and
    the timestamp are what let reconcile_paused() tell a live freeze from a
    dead one."""
    with locked(PAUSED_PATH):
        p = read_json(PAUSED_PATH) or {}
        if val:
            p[name] = {"reason": reason, "pids": sorted(pids or []),
                       "at": round(time.time(), 3)}
        else:
            p.pop(name, None)
        save_json(PAUSED_PATH, p)


def protected(pids):
    """The subset of `pids` that must never be stopped, whatever asked. A last
    line under the label matching: one wrong regex should not be able to take
    the window server down, and app_pids has been wrong before.

    A process a terminal owns is on the list too, and this is the rule that
    matters for Claude Code. SIGSTOP to a shell's foreground job is a Ctrl-Z
    as far as the shell is concerned: it prints "suspended", takes the terminal
    back and shows a prompt. The SIGCONT half of a duty cycle then continues a
    process that is no longer in the foreground, and its next read of the
    terminal stops it again (SIGTTIN). So a "throttled" terminal job is a dead
    one after the first period, and the orphan sweep will not wake it because
    it correctly refuses to touch a shell's jobs. Found 2026-09-04: Low Data
    throttling "Claude Code" suspended a session ten seconds after it was
    started, `lowdata off` could not bring it back, and the second session
    opened in its place was what "it keeps pausing things" looked like. The
    honest answer is that a process-level hold cannot throttle a terminal
    job at all, so none is ever attempted."""
    info = {pid: (tty, ucomm) for pid, tty, ucomm in ps_tty_ucomm()}
    out, jobs = set(), set()
    for pid in pids:
        tty, ucomm = info.get(pid, ("??", ""))
        if ucomm in NEVER_FREEZE or friendly(ucomm) in NEVER_FREEZE:
            out.add(pid)
        elif tty and tty != "??":
            out.add(pid)
            jobs.add(ucomm or str(pid))
    if jobs:
        _log_repeating("terminal", "left running, a terminal owns them and a "
                       "stop there is a Ctrl-Z the shell keeps: "
                       + ", ".join(sorted(jobs)))
    return out


def signal_pids(pids, sig):
    """Returns the pids actually signalled, so the caller can record them."""
    pids = list(pids)
    if sig == signal.SIGSTOP:
        # Hoisted out of the comprehension it used to sit in. protected() costs
        # a full `ps`, and as a condition it paid that once per pid: stopping
        # Cursor's 36 helpers ran `ps` 36 times and took half a second, every
        # stop of every duty cycle. The overrun landed in the app's awake half,
        # so a 25% throttle measured 47% stopped on 2026-08-31 instead of 75%,
        # which is most of why Low Data felt like it was not holding anything.
        skip = protected(pids)
        pids = [p for p in pids if p not in skip]
    sent = []
    for pid in pids:
        with contextlib.suppress(ProcessLookupError, PermissionError):
            os.kill(pid, sig)
            sent.append(pid)
    return sent


def signal_app(name, sig):
    return signal_pids(app_pids(name), sig)


def parse_etime(s):
    """`ps -o etime=` as seconds: [[dd-]hh:]mm:ss."""
    days = 0
    if "-" in s:
        d, _, s = s.partition("-")
        days = int(d)
    parts = [int(x) for x in s.split(":")]
    while len(parts) < 3:
        parts.insert(0, 0)
    return days * 86400 + parts[0] * 3600 + parts[1] * 60 + parts[2]


def proc_info(pids):
    """{pid: (state, started_epoch)} for the pids that still exist."""
    pids = [p for p in pids if p > 0]
    if not pids:
        return {}
    out = subprocess.run(["ps", "-o", "pid=,state=,etime=", "-p",
                          ",".join(str(p) for p in pids)],
                         capture_output=True, text=True).stdout
    now = time.time()
    info = {}
    for line in out.splitlines():
        f = line.split()
        if len(f) < 3 or not f[0].isdigit():
            continue
        try:
            info[int(f[0])] = (f[1], now - parse_etime(f[2]))
        except ValueError:
            continue
    return info


def mode_holds(cfg, name, reason):
    """Is the mode that froze this app still asking for it to be frozen?
    `cap` and `manual` are one-shot, so they never hold."""
    if not cfg.get("enforce", True):
        return False
    if reason == "lowdata":
        return bool(cfg["lowdata"]) and canonical(name) in {
            canonical(a) for a in cfg.get("lowdata_apps") or []}
    if reason == "all":
        # Soft Pause All holds a throttle, not a freeze, so it never asks for
        # one back. Without the hard check, reconcile would re-freeze an app the
        # soft stage had just let up to its 5%.
        return bool(cfg.get("pause_all")) and bool(cfg.get("pause_all_hard")) \
            and canonical(name) not in {
                canonical(a) for a in cfg.get("pause_all_allow") or []}
    return False


def stopped_procs():
    """{pid: (tty, command line)} for every process in state T, in one `ps`.

    The alternative is pgrep-per-app plus a ps sweep per app, which is ~120
    subprocesses for a forty-app day. This runs once a minute in the daemon, so
    it has to be one call.

    The tty rides along because it is what separates netmeter's business from
    the shell's: `??` for a process no terminal owns, a device name for one a
    shell can suspend. See sweep_orphans."""
    out = subprocess.run(["ps", "-Axo", "pid=,state=,tty=,command="],
                         capture_output=True, text=True).stdout
    procs = {}
    for line in out.splitlines():
        f = line.split(None, 3)
        if len(f) < 4 or not f[0].isdigit() or not f[1].startswith("T"):
            continue
        procs[int(f[0])] = (f[2], f[3])
    return procs


def sweep_candidates(claimed=()):
    """The stopped processes the sweep may consider, and the jobs it must not.

    Returns ({pid: cmd}, {pid: cmd}): what is fair game, and what a terminal
    owns. Job control is the whole reason for the split. Ctrl-Z stops a process
    group, SIGTTIN and SIGTTOU stop its members again whenever they touch the
    terminal, and every one of them lands in exactly the state T the sweep reads
    as a strand. netmeter's own targets never look like that: a GUI app's
    helpers and a launchd daemon have no controlling terminal at all.

    Found live on 2026-08-28, once an hour of log said "sweep: woke 1 stranded
    process(es) of node". Two suspended terminal sessions each held a stopped
    npm exec with a node child; node was on the day's app list, so the sweep
    woke the child of a job the user had deliberately put to sleep, the shell
    re-stopped it on its next read, and the two of them traded the process back
    and forth every minute. Nothing was ever stranded.

    The cost of the rule is narrow and worth naming: a process netmeter froze
    that does have a terminal (`node server.js` in a shell) will not be picked
    up by the sweep if its bookkeeping is lost. `netmeter paused` says so rather
    than leaving it to be discovered."""
    fair, jobs = {}, {}
    for pid, (tty, cmd) in stopped_procs().items():
        if pid in claimed:
            continue
        (jobs if tty and tty != "??" else fair)[pid] = cmd
    return fair, jobs


def sweep_orphans(cfg=None):
    """SIGCONT anything netmeter can see stopped that no record claims.

    paused.json is intent, `ps` is truth, and on 2026-08-28 they diverged badly
    enough to strand 35 processes. A duty cycle's SIGSTOP landed a moment after
    `resume-all` cleared the bookkeeping, so `netmeter paused` reported "Nothing
    is paused" over 27 stopped Cursor helpers, five WebKit processes and cloudd,
    with no way back short of `kill -CONT` by hand. reconcile_paused() could not
    have found them either: it only walks entries that already exist. This walks
    the other direction, from what is actually stopped back to whether anything
    still wants it stopped.

    The candidate set is deliberately narrow: apps netmeter has watched move
    bytes today, plus the names on its own mode lists. It will not touch a
    process netmeter has never met, and it will not touch one a terminal owns,
    which is where a suspended shell job lives (see sweep_candidates). Anything
    a live record does claim (paused, throttled, mid-ramp) is left alone, which
    is what keeps it off a duty cycle's back: a throttled app is legitimately
    stopped for most of every period."""
    cfg = cfg or load_config()
    paused = read_paused()
    busy = set(paused) | set(read_throttled()) | set(read_ramping())
    claimed = set()
    for e in paused.values():
        claimed.update(e["pids"])
    # Skipping busy *names* is not enough, because the label holding a process
    # down is not always the label the day's table files it under. The throttle
    # held "Claude"; nettop reported its helpers as "Claude Helper"; that name
    # was on the day's list, nothing claimed it, and the sweep woke six of the
    # eight processes the duty cycle was stopping, once a minute, for days.
    # ("node" did the same to Cursor's extension host.) Claiming by pid closes
    # the whole class: whatever a busy app's processes are called, they are
    # stopped on purpose and the sweep passes over them.
    for name in busy:
        claimed.update(app_pids(name))
    today = load(datetime.date.today().isoformat())
    names = (set(today.get("apps") or {})
             | set(cfg.get("lowdata_apps") or [])
             | set(cfg.get("lowdata_throttle") or [])
             | set(cfg.get("pause_all_allow") or []))
    procs, _ = sweep_candidates(claimed)
    if not procs:
        return {}
    woken = {}
    for name in sorted(names - busy):
        if name in NEVER_FREEZE:
            continue
        pattern = canonical(name)
        rx = re.compile(app_pattern(pattern))
        friend = [pat for pat, label in FRIENDLY if label == pattern]
        hits = []
        for pid, cmd in procs.items():
            base = os.path.basename(cmd.split(" ")[0])
            if rx.search(cmd) or base == pattern or any(p.match(base) for p in friend):
                hits.append(pid)
        if hits:
            sent = signal_pids(hits, signal.SIGCONT)
            if sent:
                woken[name] = sent
                log(f"sweep: woke {len(sent)} stranded process(es) of {name}")
    return woken


def reconcile_paused(cfg=None):
    """Make paused.json agree with what is actually stopped, and unstop what
    nothing is asking to be stopped any more.

    Nothing used to check. paused.json changed only on an explicit pause or
    resume, so an app that was frozen, force-quit and relaunched stayed listed
    as paused forever, and the helper processes stopped alongside it stayed
    stopped forever with it: on 2026-08-28 three Chrome crashpad handlers had
    been sitting in state T for four days, under an entry claiming Chrome was
    frozen while Chrome was running. Four cases, in order:

      no processes left        -> drop the entry, the app is gone
      a mode still holds it    -> freeze any process that got away
      nothing is stopped       -> drop it, something resumed the app already
      stopped and running both -> the app came back; free the leftovers

    The last case is the orphan sweep, and it is why entries carry the pids and
    the timestamp: a process younger than the freeze cannot be one we froze."""
    cfg = cfg or load_config()
    lifted, refroze, dropped = [], [], []
    for name, entry in read_paused().items():
        known = set(entry["pids"]) | set(app_pids(name))
        info = proc_info(known)
        if not info:
            set_paused(name, False)
            dropped.append(name)
            continue
        stopped = {p for p, (st, _) in info.items() if st.startswith("T")}
        running = set(info) - stopped
        if mode_holds(cfg, name, entry["reason"]):
            if running:
                sent = signal_pids(running, signal.SIGSTOP)
                if sent:
                    refroze.append(name)
            set_paused(name, True, entry["reason"], set(info))
            continue
        if not stopped:
            set_paused(name, False)
            dropped.append(name)
            continue
        if not running:
            continue                      # a clean, intentional freeze
        # Both states at once. A process that started after the freeze belongs
        # to a relaunched app, so the stopped ones are leftovers of the old.
        # A legacy entry (at == 0) cannot date anything, and every one of those
        # seen in the wild was exactly this case, so it resolves the same way.
        newer = [p for p in running if info[p][1] > entry["at"]]
        if newer or not entry["at"]:
            signal_pids(stopped, signal.SIGCONT)
            set_paused(name, False)
            lifted.append(name)
        else:
            signal_pids(running, signal.SIGSTOP)
            set_paused(name, True, entry["reason"], set(info))
            refroze.append(name)
    # The backstop under everything above. Reconcile fixes entries that exist;
    # the sweep is the only thing that can find a freeze no entry describes, and
    # a minute is a tolerable worst case for one to sit there.
    sweep_orphans(cfg)
    if lifted or refroze or dropped:
        msg = "reconcile: " + " ".join(filter(None, [
            f"freed {', '.join(lifted)};" if lifted else "",
            f"re-froze {', '.join(refroze)};" if refroze else "",
            f"forgot {', '.join(dropped)}" if dropped else ""]))
        _log_repeating("reconcile", msg)
    return lifted, refroze, dropped


# A standing fight writes the same line once a minute for as long as it lasts.
# launchd restarts the background downloaders Low Data freezes, so a long
# tethered session logged "re-froze cloudd, nsurlsessiond" 113 times, and the
# one line that mattered ("sweep: woke 6 stranded process(es) of Claude Helper")
# sat in the middle of them for three days. Say it when it changes, and say it
# again every quarter hour so a fight that never ends is still visible.
_REPEATS = {}
REPEAT_EVERY = 900


def _log_repeating(key, msg):
    last_msg, last_at = _REPEATS.get(key, (None, 0.0))
    now = time.time()
    if msg == last_msg and now - last_at < REPEAT_EVERY:
        return
    line = msg
    if msg == last_msg:
        line += f" (unchanged for {int((now - last_at) / 60)} min)"
    _REPEATS[key] = (msg, now)
    log(line)


HOLD_WHY = {"manual": "by hand", "lowdata": "Low Data", "cap": "burst cap",
            "all": "Pause All", "ramp": "ramp"}


def holding_now(cfg=None, tether_on=None):
    """Two lists: what netmeter is holding this second, and what is armed to
    hold. This is the answer to "is netmeter interfering right now", which
    used to take reading three state files and knowing that the burst cap is
    armed by the metered network even with every mode off. The daemon writes
    both into now.json every tick; the menu and `netmeter paused` print them."""
    cfg = cfg or load_config()
    holding = []
    for name, e in sorted(read_paused().items()):
        holding.append(f"{name} frozen ({HOLD_WHY.get(e['reason'], e['reason'])})")
    for name in sorted(read_ramping()):
        holding.append(f"{name} stopping")
    for name, v in sorted(read_throttled().items()):
        r = (v or {}).get("reason", "manual")
        if r == "ramp":
            continue
        holding.append(f"{name} at {(v or {}).get('pct', 25)}% ({HOLD_WHY.get(r, r)})")
    if not cfg.get("enforce", True):
        return holding, ["monitor only: nothing is held"]
    armed = []
    if cfg.get("lowdata"):
        armed.append("Low Data")
    if cfg.get("pause_all"):
        armed.append("Pause All" + (" (hard)" if cfg.get("pause_all_hard") else ""))
    if tether_on is None:
        now = read_json(NOW_PATH) or {}
        tether_on = bool(now.get("tether_on")) and \
            time.time() - float(now.get("ts") or 0) < 60
    via = ("Low Data" if cfg.get("lowdata")
           else (cfg.get("tether_name") or "the metered network"))
    if not cfg.get("burst_cap_on", True):
        return holding, armed
    if (cfg.get("burst_cap_mb") or 0) and (cfg.get("lowdata") or tether_on):
        armed.append(f"burst cap {cfg['burst_cap_mb']} MB/min, by {via}")
    if (cfg.get("drain_cap_mb") or 0) and (cfg.get("lowdata") or tether_on):
        armed.append(f"drain cap {cfg['drain_cap_mb']} MB, by {via}")
    return holding, armed


def cap_cmd(action):
    """`netmeter cap on|off`: the burst cap (and the drain cap) as a switch.
    Off, nothing is frozen for moving too much, on any network, whatever Low
    Data says; the sizes stay in config for when it comes back."""
    cfg = load_config()
    if action in ("on", "off"):
        cfg = update_config(burst_cap_on=(action == "on"))
        log(f"burst cap: {action} (by hand)")
    on = cfg.get("burst_cap_on", True)
    size = cfg.get("burst_cap_mb") or 0
    print(f"Burst cap {'on' if on else 'off'}"
          + (f": {size} MB/min, armed by Low Data or the metered network" if on and size
             else (": no size set (burst_cap_mb)" if on else
                   ". Nothing is frozen for moving too much until: netmeter cap on")))


def enforce_cmd(action):
    """`netmeter enforce off` is monitor only: count everything, hold nothing.
    The modes keep their positions in config so `enforce on` puts them back;
    what changes is whether anything acts on them. Every hold standing at the
    moment it goes off is released here, and the daemon's tick, the throttle
    worker, reconcile and the caps all read the same flag and stand down."""
    cfg = load_config()
    if action == "off":
        cfg = update_config(enforce=False)
        log("monitor only: on (nothing is held from here)")
        paused, throttled = read_paused(), read_throttled()
        for path in (PAUSED_PATH, THROTTLED_PATH, RAMP_PATH):
            with locked(path):
                save_json(path, {})
        for name, e in paused.items():
            signal_app(name, signal.SIGCONT)
            signal_pids(e.get("pids") or [], signal.SIGCONT)
        for name in throttled:
            signal_app(name, signal.SIGCONT)
        background_lift()
        update_prefs_restore()
        sweep_orphans(cfg)
        n = len(set(paused) | set(throttled))
        print(f"Monitor only. Released {n} app(s). netmeter keeps counting and "
              "notifying and holds nothing: no freezes, no throttles, no burst "
              "cap, whatever Low Data or Pause All say. Back with: netmeter enforce on")
    elif action == "on":
        cfg = update_config(enforce=True)
        log("monitor only: off (modes enforce again)")
        if cfg.get("lowdata"):
            lowdata_apply(cfg)
        print("Enforcing again." + (" Low Data re-applied." if cfg.get("lowdata")
                                    else "") + (" Pause All resumes on the next tick."
                                                if cfg.get("pause_all") else ""))
    else:
        print("monitor only" if not cfg.get("enforce", True) else "enforcing")
        holding, armed = holding_now(cfg)
        print("  holding: " + (" · ".join(holding) if holding else "nothing"))
        print("  armed: " + (" · ".join(armed) if armed else "nothing"))


def show_paused(jobs=False):
    """What is frozen, why, and whether the freeze is real."""
    reconcile_paused()
    holding, armed = holding_now()
    print("  armed: " + (" · ".join(armed) if armed else "nothing"))
    paused = read_paused()
    if not paused:
        print("Nothing is paused.")
    else:
        why = {"manual": "by hand", "lowdata": "by low data mode",
               "cap": "by the burst cap",
               "all": "by pause all"}
        for name, e in sorted(paused.items()):
            info = proc_info(set(e["pids"]) | set(app_pids(name)))
            n = sum(1 for st, _ in info.values() if st.startswith("T"))
            print(f"  {name}: {why.get(e['reason'], e['reason'])}, "
                  f"{n} process(es) stopped")
    for name, e in sorted(read_ramping().items()):
        age = time.time() - float(e.get("started", 0))
        end = ("freezing" if e.get("land", True)
               else f"settling at {PAUSE_ALL_FLOOR}%")
        print(f"  {name}: ramping down ({age:.0f}s in), {end} once it goes quiet")
    t = read_throttled()
    for name, v in sorted(t.items()):
        if (v or {}).get("reason") == "ramp":
            continue          # already named above, as the ramp it belongs to
        held = " and held there by pause all" if (v or {}).get("reason") == "all" else ""
        print(f"  {name}: throttled to {v.get('pct', 25)}%{held}")
    # The sweep will not touch these, so this is the only place they surface.
    # Almost always a Ctrl-Z'd shell job, which is nobody's business but the
    # shell's; occasionally something netmeter froze from a terminal and lost
    # the record of, which is worth being able to see.
    _, held = sweep_candidates()
    if held and not jobs:
        print(f"  ({len(held)} stopped terminal job(s) left alone; a shell owns "
              f"those, and netmeter never stops a terminal job. See them with: "
              f"netmeter paused --jobs)")
    elif held:
        print(f"  {len(held)} stopped terminal job(s), left alone:")
        for pid, cmd in sorted(held.items()):
            print(f"    {pid}  {cmd[:96]}")
        print("    Resume one in the shell that owns it (fg), or: kill -CONT <pid>")


def pause(name, quiet=False, reason="manual"):
    cfg = load_config()
    if not cfg.get("enforce", True):
        if not quiet:
            print(f"Monitor only is on, so {canonical(name)} is not held. "
                  "Lift it with: netmeter enforce on")
        return
    # The ramp needs a long-lived process to step it. With no daemon there is
    # nothing to do the stepping, so the freeze stays immediate rather than
    # being silently dropped.
    if cfg.get("ramp", True) and daemon_running() and app_pids(name):
        ramp_start(name, reason)
        if not quiet:
            span = cfg.get("ramp_seconds") or 8.0
            print(f"Slowing {canonical(name)} to a stop over the next "
                  f"{span:.0f}s, once it goes quiet. "
                  f"Undo with: netmeter resume {name}")
        pids = []
    else:
        pids = signal_app(name, signal.SIGSTOP)
        if pids:
            set_paused(canonical(name), True, reason, pids)
    if cfg.get("pause_all"):
        # Pausing by hand under pause-all mode means "no, I did mean this one":
        # take it back off the allow list so the next tick keeps it frozen.
        allow = [a for a in cfg.get("pause_all_allow") or []
                 if canonical(a) != canonical(name)]
        if len(allow) != len(cfg.get("pause_all_allow") or []):
            update_config(pause_all_allow=allow)
    if quiet:
        return
    if pids:
        print(f"Froze {len(pids)} process(es) matching '{name}'. The app's window "
              f"will be unresponsive until you run: netmeter resume {name}")
    elif not read_ramping().get(canonical(name)):
        print(f"No running processes match '{name}'.")


def resume(name):
    ramping = ramp_cancel(name)
    pids = signal_app(name, signal.SIGCONT)
    set_paused(canonical(name), False)
    # Resume means "leave this app alone", so it lifts a throttle too. Without
    # this the SIGCONT is undone by the next duty cycle a second later.
    set_throttled(canonical(name), 0)
    cfg = load_config()
    if cfg.get("pause_all"):
        # Same reasoning one level up: under pause-all mode the daemon re-freezes
        # on sight, so a resume that does not add to the allow list lasts a tick.
        # This is the selective half of "pause everything, then let a few back".
        allow = list(cfg.get("pause_all_allow") or [])
        if canonical(name) not in {canonical(a) for a in allow}:
            allow.append(canonical(name))
            cfg = update_config(pause_all_allow=allow)
        print(f"Allowed {canonical(name)} while Pause All is on "
              f"({len(allow)} allowed).")
    if ramping and not pids:
        print(f"Stopped ramping {canonical(name)} down; it stays running.")
    if pids:
        print(f"Resumed {len(pids)} process(es) matching '{name}'."
              + (" It was still ramping down." if ramping else ""))
        if cfg["lowdata"] and canonical(name) in {
                canonical(a) for a in cfg.get("lowdata_apps") or []}:
            print("Note: low data mode is still ON, the daemon will re-freeze it. "
                  "Run: netmeter lowdata off")
    else:
        print(f"No running processes match '{name}'.")


def resume_all():
    """Let everything go: freezes, ramps, held throttles, and the modes behind
    them.

    The order is the fix. This used to signal first and clear the state files
    afterwards, which leaves a window where the daemon is still enforcing a mode
    it is about to be told is over, and it cleared them with a bare save_json
    against writers that take a lock. On 2026-08-28 the two together stranded 35
    processes: the throttle worker's SIGSTOP landed just after the SIGCONTs, its
    set_paused() write landed inside the unlocked clear and was overwritten by
    it, and the result was 27 stopped Cursor helpers described by an empty
    paused.json. Now enforcement is switched off first, the signals go second,
    and sweep_orphans() picks up whatever a duty cycle stopped in the gap."""
    cfg = load_config()
    if cfg.get("pause_all"):
        # The allow list survives; see pause_all().
        update_config(pause_all=False, pause_all_hard=False)
    paused = read_paused()
    throttled = read_throttled()
    ramping = read_ramping()
    for path in (PAUSED_PATH, THROTTLED_PATH, RAMP_PATH):
        with locked(path):
            save_json(path, {})
    for name in set(paused) | set(throttled) | set(ramping):
        signal_app(name, signal.SIGCONT)
        # The pids we recorded outlive the label: an app whose process list has
        # since changed still has our SIGSTOPs on the old ones.
        signal_pids(paused.get(name, {}).get("pids", []), signal.SIGCONT)
    orphans = sweep_orphans(cfg)
    n = len(set(paused) | set(throttled) | set(ramping))
    tail = " Pause All is off." if cfg.get("pause_all") else ""
    if orphans:
        tail += (f" Also woke {sum(len(v) for v in orphans.values())} stranded "
                 f"process(es): {', '.join(sorted(orphans))}.")
    print((f"Resumed {n} app(s).{tail}") if n else
          (f"Nothing was paused or throttled.{tail}"))


def resume_reason(reason):
    """Let go of everything a given mode is holding: its ramps, its freezes and
    its held throttles. Returns how many apps that was.

    The throttle half arrived with Pause All's soft stage on 2026-08-28. Before
    it, lifting a mode dropped the mode's freezes and left its throttles
    running, which under a mode that now *ends* at a throttle would have lifted
    nothing at all."""
    for name, entry in read_ramping().items():
        if entry.get("reason") == reason:
            ramp_cancel(name)
            signal_app(name, signal.SIGCONT)
    held = unthrottle_reason(reason)
    paused = read_paused()
    names = [n for n, e in paused.items() if e["reason"] == reason]
    for name in names:
        signal_app(name, signal.SIGCONT)
        signal_pids(paused[name]["pids"], signal.SIGCONT)
        set_paused(name, False)
    return len(names) + held


# --- the ramp ------------------------------------------------------------
# A pause used to be a SIGSTOP and nothing else, which is a wall rather than a
# stop: an app mid-request loses the request, an app mid-save can lose worse,
# and the window is unresponsive from one instant to the next. Turning off the
# wifi does not feel like that, because the app gets to notice. So a pause now
# spends a few seconds on the way down: 25% of its duty cycle, then 5%, then a
# freeze once the app has actually gone quiet. It cannot make an app stay alive
# and offline at the same time (that needs a Network Extension, which is the
# founding limit of this tool), but it can stop being abrupt about the landing.
#
# Since Pause All grew two stages the ramp has two landings. A pause still ends
# in a freeze. Pause All's soft stage ends at PAUSE_ALL_FLOOR and stays there,
# which is the same slope stopping one step short of the wall.


def read_ramping():
    return read_json(RAMP_PATH) or {}


def ramp_start(name, reason, land=True):
    """Begin a ramp, or leave a running one alone. The daemon does the stepping;
    the CLI only records the intent, because a CLI process that exits in 40ms
    cannot hold a duty cycle.

    `land` is what the ramp is a ramp *to*. True ends in a freeze, which is what
    a pause means. False ends at PAUSE_ALL_FLOOR and stays there, which is what
    Pause All's soft stage means: the same slope, a different bottom."""
    name = canonical(name)
    with locked(RAMP_PATH):
        r = read_json(RAMP_PATH) or {}
        if name in r:
            return False
        r[name] = {"reason": reason, "started": round(time.time(), 3),
                   "land": bool(land)}
        save_json(RAMP_PATH, r)
    set_throttled(name, 25, "ramp")
    return True


def ramp_cancel(name):
    """Stop ramping an app and lift the ramp's throttle. Resuming an app that is
    on its way down has to catch it there, or the daemon freezes it a tick later
    and the switch you just flipped appears to do nothing."""
    name = canonical(name)
    with locked(RAMP_PATH):
        r = read_json(RAMP_PATH) or {}
        if name not in r:
            return False
        r.pop(name)
        save_json(RAMP_PATH, r)
    if (read_throttled().get(name) or {}).get("reason") == "ramp":
        set_throttled(name, 0)
    return True


def ramp_done(name):
    """Take an app off the ramp without lifting the throttle the ramp applied.
    ramp_cancel() is the other ending: it means "never mind", so it lifts. This
    one means "arrived", and what it arrives at is the hold."""
    name = canonical(name)
    with locked(RAMP_PATH):
        r = read_json(RAMP_PATH) or {}
        r.pop(name, None)
        save_json(RAMP_PATH, r)


def ramp_step(cfg, tick_bytes):
    """Advance every ramp one tick. `tick_bytes` is per-app bytes moved in the
    sample just read, which is how "has it gone quiet" gets answered without
    keeping a second history."""
    ramping = read_ramping()
    if not ramping:
        return []
    now = time.time()
    span = max(1.0, float(cfg.get("ramp_seconds") or 8.0))
    deadline = max(span, float(cfg.get("ramp_max") or 30.0))
    quiet_at = max(0, int(cfg.get("ramp_quiet_kb") or 50)) * KB
    landed = []
    for name, entry in ramping.items():
        elapsed = now - float(entry.get("started", now))
        reason = entry.get("reason", "manual")
        if elapsed >= span:
            quiet = tick_bytes.get(name, 0) <= quiet_at
            if not (quiet or elapsed >= deadline):
                continue          # still busy, and there is deadline left
            if not entry.get("land", True):
                # The soft landing: off the ramp, still throttled, and the
                # throttle changes hands from the ramp to the mode that asked
                # for it, so lifting the mode lifts the hold.
                ramp_done(name)
                set_throttled(name, PAUSE_ALL_FLOOR, reason)
                landed.append((name, "holding"))
                continue
            ramp_cancel(name)
            pids = signal_app(name, signal.SIGSTOP)
            if pids:
                set_paused(name, True, reason, pids)
                landed.append((name, "froze"))
        elif elapsed >= span / 2:
            if (read_throttled().get(name) or {}).get("pct") != PAUSE_ALL_FLOOR:
                set_throttled(name, PAUSE_ALL_FLOOR, "ramp")
    return landed


def pause_all_apply(cfg, names):
    """Put everything in `names` under Pause All that the mode has not been told
    to allow. Called on `pause-all` with the day's app list, and on every daemon
    tick with the apps that just moved bytes, which is what makes the mode a
    mode rather than a one-off sweep.

    Where an app lands depends on the stage. Soft, the default, ramps it down to
    PAUSE_ALL_FLOOR% of the duty cycle and leaves it there: slow enough to save
    the data, alive enough that the app you are working in keeps working. Hard
    lands the freeze, which is what the mode used to do on its own until it did
    it to Cursor mid-session on 2026-08-28."""
    if not cfg.get("enforce", True):
        return []
    hard = bool(cfg.get("pause_all_hard"))
    allow = {canonical(a) for a in cfg.get("pause_all_allow") or []}
    already = read_paused()
    throttled = read_throttled()
    ramping = read_ramping()
    ramp = cfg.get("ramp", True) and daemon_running()
    started = []
    for name in names:
        if name in NEVER_FREEZE or canonical(name) in allow or name in already:
            continue
        if canonical(name) in ramping:
            continue
        if not hard and (throttled.get(name) or {}).get("reason") == "all":
            continue          # already parked at the floor
        if ramp:
            if app_pids(name):
                ramp_start(name, "all", land=hard)
                started.append(name)
            continue
        if hard:
            pids = signal_app(name, signal.SIGSTOP)
            if pids:
                set_paused(name, True, "all", pids)
                started.append(name)
        elif app_pids(name):
            # No daemon, so no duty cycle and nothing to hold the hold. The
            # entry is written anyway, so the mode reads honestly and starts
            # being enforced the moment a daemon comes back.
            set_throttled(name, PAUSE_ALL_FLOOR, "all")
            started.append(name)
    return started


def pause_all_hard_stop(cfg):
    """Land the freeze on everything Pause All is holding, now.

    No ramp: the hold already is the bottom of one, and spending another eight
    seconds at 5% on the way to a stop the user has just asked for twice would
    be the tool arguing. Anything the mode has not touched yet but has seen
    today goes down with it, so Hard Stop means all of it."""
    allow = {canonical(a) for a in cfg.get("pause_all_allow") or []}
    already = read_paused()
    names = {n for n, v in read_throttled().items()
             if (v or {}).get("reason") in ("all", "ramp")}
    names |= set(read_ramping())
    names |= set(load(datetime.date.today().isoformat())["apps"])
    frozen = []
    for name in sorted(names):
        if name in NEVER_FREEZE or canonical(name) in allow or name in already:
            continue
        ramp_cancel(name)
        set_throttled(name, 0)
        pids = signal_app(name, signal.SIGSTOP)
        if pids:
            set_paused(name, True, "all", pids)
            frozen.append(name)
    return frozen


def pause_all(action):
    """`netmeter pause-all` / `pause-all off` / bare `pause-all` for status.

    This replaced solo mode on 2026-08-28. Solo picked one app and defended it;
    this freezes the lot and lets you name exceptions afterwards, one switch at
    a time, which is the shape of the actual question on a metered link: not
    "which one app do I want" but "which handful can I live without". Solo was
    the same mode with the allow list capped at one, so it became a preset of
    this one and then stopped being worth its own machinery.

    It has two stages, since 2026-08-28. On, the soft one, ramps everything down
    to PAUSE_ALL_FLOOR% and holds it there; `hard` lands the freeze; `soft` goes
    back to the hold; `off` lifts the lot. The mode used to have only the hard
    stage, which meant pressing it once stopped the editor the press was made
    from. A hold is the answer to the question people actually ask on a metered
    link, and a freeze is the answer to a question worth pressing twice for.

    There are no app exemptions. Cursor and Claude Code go down with everything
    else; the only things spared are NEVER_FREEZE, which is the system floor,
    and netmeter itself, because freezing what does the unfreezing leaves no way
    back."""
    cfg = load_config()
    if action == "status":
        if not cfg.get("pause_all"):
            print("off")
            return
        allow = cfg.get("pause_all_allow") or []
        stage = ("hard stopped" if cfg.get("pause_all_hard")
                 else f"holding everything at {PAUSE_ALL_FLOOR}%")
        print(f"Pause All is ON, {stage}. "
              f"Allowed: {', '.join(allow) if allow else 'nothing yet'}.")
        return
    if action == "clear":
        update_config(pause_all_allow=[])
        print("Allow list cleared. The next Pause All starts from nothing.")
        return
    if action == "off":
        # The allow list survives. The apps worth letting through are the ones
        # you work in, and they are the same ones tomorrow: making you re-pick
        # them every time would be the tool forgetting something it watched you
        # decide. `pause-all clear` is how you throw it away on purpose.
        update_config(pause_all=False, pause_all_hard=False)
        n = resume_reason("all")
        sweep_orphans()
        allow = cfg.get("pause_all_allow") or []
        tail = f" Still allowing {', '.join(allow)} next time." if allow else ""
        print(f"Pause All OFF. Resumed {n} app(s).{tail}")
        return
    if action == "hard":
        cfg = update_config(pause_all=True, pause_all_hard=True)
        frozen = pause_all_hard_stop(cfg)
        allow = cfg.get("pause_all_allow") or []
        print(f"Hard Stop ON. Froze {len(frozen)} app(s)"
              f"{': ' + ', '.join(frozen) if frozen else ''}."
              + (f" Still allowing {', '.join(allow)}." if allow else "") +
              " Their windows will be unresponsive until you run "
              "`netmeter pause-all soft` or `netmeter resume-all`.")
        return
    if action == "soft":
        if not cfg.get("pause_all"):
            print("Pause All is off, so there is nothing to soften. "
                  "`netmeter pause-all` turns it on.")
            return
        cfg = update_config(pause_all_hard=False)
        # The apps coming off the freeze go straight back onto the hold, named
        # explicitly rather than left to today's list: an app frozen since this
        # morning may not have moved a byte since, and "it stopped showing up in
        # the totals" is not a reason to let it back to full speed.
        held = [n for n, e in read_paused().items() if e["reason"] == "all"]
        n = resume_reason("all")
        sweep_orphans()
        today = load(datetime.date.today().isoformat())
        pause_all_apply(cfg, sorted(set(held) | set(today["apps"])))
        print(f"Hard Stop OFF. Woke {n} app(s); Pause All is still on and "
              f"everything is back to {PAUSE_ALL_FLOOR}% of its duty cycle.")
        return
    cfg = update_config(pause_all=True, pause_all_hard=False)
    today = load(datetime.date.today().isoformat())
    started = pause_all_apply(cfg, list(today["apps"]))
    allow = cfg.get("pause_all_allow") or []
    live = cfg.get("ramp", True) and daemon_running()
    verb = "Ramping down" if live else "Throttled"
    warn = ("" if daemon_running() else
            " The daemon is not running, so nothing is holding the throttle:"
            " start it with `netmeter start`.")
    print(f"Pause All ON. {verb} {len(started)} app(s)"
          f"{': ' + ', '.join(started) if started else ''} to "
          f"{PAUSE_ALL_FLOOR}% and holding."
          + (f" Allowing {', '.join(allow)}." if allow else "") +
          f" Anything else that reaches for the network gets throttled on sight."
          f" Switch individual apps back on to allow them, "
          f"`netmeter pause-all hard` to freeze the lot outright, or "
          f"`netmeter resume-all` to lift the whole thing.{warn}")


# --- throttle -----------------------------------------------------------
# Pause is all-or-nothing, and for some apps that makes it useless: freezing a
# running work session is not a saving, it is a stall you have to undo by hand.
# (The menu bar knows this: Claude Code is in its PAUSE_DENY list for exactly
# that reason.) Throttling duty-cycles SIGSTOP/SIGCONT instead: an app set to
# 25% runs for a quarter of each period and is frozen for the rest. Nothing
# rate-limits the socket directly; TCP does it, because a stopped process stops
# draining its receive buffer, the window closes, and the sender backs off. The
# transfer slows down rather than failing, which is the whole point.
#
# The cycle is aimed at the processes moving the bytes, not at every process
# the app's label matches. It used to be the label, and for an Electron app
# that is the wrong set: measured on Cursor on 2026-09-02, every byte in a
# ten-second sample came from the extension hosts (`Cursor Helper (Plugin)`),
# while the main process, the renderers that draw the editor and the GPU
# process moved nothing and were stopped three seconds in four along with
# them. That was the "Cursor freezes under Low Data" Sean kept hitting: not a
# fault in the cycle but the cycle landing on the half of the app that draws
# the window. The daemon's own nettop feed says which pids are talking, so the
# throttle holds those and leaves the rest alone. The AI calls slow down; the
# keystrokes do not. A process that starts talking is caught on the next
# sample, and one that has been quiet for CARRIER_WINDOW is let go, so an idle
# app is not signalled at all. Hard freezes (pause, the burst cap, Pause All's
# second stage) still take the whole app: those are meant to stop it dead.
CARRIERS = {}                  # pid -> last time nettop saw it move bytes
CARRIERS_LOCK = threading.Lock()
CARRIER_WINDOW = 60.0


def mark_carrier(pid, ts=None):
    with CARRIERS_LOCK:
        CARRIERS[pid] = time.time() if ts is None else ts


def prune_carriers(now=None):
    now = time.time() if now is None else now
    with CARRIERS_LOCK:
        for pid in [p for p, t in CARRIERS.items() if now - t > CARRIER_WINDOW]:
            del CARRIERS[pid]


def carriers_among(pids, now=None):
    """The subset of `pids` nettop has seen moving bytes inside CARRIER_WINDOW."""
    now = time.time() if now is None else now
    with CARRIERS_LOCK:
        return [p for p in pids
                if p in CARRIERS and now - CARRIERS[p] <= CARRIER_WINDOW]


def read_throttled():
    return read_json(THROTTLED_PATH) or {}


def set_throttled(name, pct, reason="manual"):
    """throttled.json maps app -> {"pct", "reason"}, mirroring paused.json so
    `lowdata off` can lift exactly what low data mode throttled."""
    with locked(THROTTLED_PATH):
        t = read_json(THROTTLED_PATH) or {}
        before = (t.get(name) or {}).get("pct")
        if pct:
            t[name] = {"pct": int(pct), "reason": reason}
        else:
            t.pop(name, None)
        save_json(THROTTLED_PATH, t)
    # Every hold says so in the log, so "was netmeter interfering at 14:45"
    # has an answer that is not a guess.
    if pct and before != int(pct):
        log(f"throttle: {name} at {int(pct)}% ({reason})")
    elif not pct and before:
        log(f"throttle: {name} lifted")


def unfreeze_throttled():
    """A throttled app is stopped for most of every period, so a daemon that dies
    mid-cycle leaves it stopped. Called on the way out, which covers every exit
    that runs code, and on the way in, which is what covers the one that does
    not: SIGKILL cannot be handled, so a killed daemon really does leave the app
    frozen until launchd's KeepAlive restarts it a second later and this runs."""
    t = read_json(THROTTLED_PATH) or {}
    for name in t:
        signal_app(name, signal.SIGCONT)
    return len(t)


def unthrottle_reason(reason):
    """Lift only the throttles a given mode applied. Returns how many."""
    t = read_json(THROTTLED_PATH) or {}
    names = [n for n, v in t.items() if (v or {}).get("reason") == reason]
    for name in names:
        signal_app(name, signal.SIGCONT)
        set_throttled(name, 0)
    return len(names)


def burst_cap_check(bucket, cap_mb, already):
    """Freeze anything that has moved more than cap_mb inside the current minute.

    This one does not ramp, deliberately. The ramp spends its first seconds at
    25% of the duty cycle, and 25% of a fast link is tens of megabytes: a soft
    landing for the exact transfer the cap exists to stop is no cap at all.

    This is the backstop the throttle cannot be. A 953 MB minute is not a session
    ramping up, it is a bulk transfer nobody asked for, and the only thing that
    reliably stops one is taking the process off the CPU. The daemon already
    accumulates a per-app bucket for the history file, so the cap reads that
    instead of keeping a second window. `already` is the set of apps caught this
    minute, so one breach is one freeze rather than one per tick."""
    frozen = []
    limit = cap_mb * MB
    for name, (d_in, d_out) in list(bucket.items()):
        moved = d_in + d_out
        if name in already or name in NEVER_FREEZE or moved < limit:
            continue
        already.add(name)
        pids = signal_app(name, signal.SIGSTOP)
        if pids:
            set_paused(name, True, "cap", pids)
            frozen.append((name, moved))
    return frozen


def drain_check(cfg, drained, minute):
    """The bleed a per-minute cap cannot see. 30 MB a minute for ten minutes
    never trips a 50 MB/min burst cap and still costs 300 MB, which on a 50 GB
    plan is a morning. Reads the completed minutes already in recent.jsonl
    rather than keeping a second window: the file is capped, reading it once a
    minute is nothing, and it survives a daemon restart, which in-memory state
    would not.

    `drained` maps app -> the minute it was frozen, so one bleed is one freeze
    rather than one per minute. An app the user resumed deliberately is not
    re-frozen inside the same window; the next one may catch it again."""
    cap = (cfg.get("drain_cap_mb") or 0) * MB
    if not cap or not cfg.get("enforce", True) or not cfg.get("burst_cap_on", True):
        return []
    window = max(2, int(cfg.get("drain_window_min") or 5))
    paused = read_paused()
    frozen = []
    for name, (d_in, d_out) in read_recent(window).items():
        moved = d_in + d_out
        if moved < cap or name in NEVER_FREEZE or name in paused:
            continue
        if minute - drained.get(name, -10 ** 9) < window:
            continue
        pids = signal_app(name, signal.SIGSTOP)
        if pids:
            set_paused(name, True, "cap", pids)
            drained[name] = minute
            frozen.append((name, moved))
    return frozen


def daemon_running():
    out = subprocess.run(["pgrep", "-f", "netmeter start"],
                         capture_output=True, text=True).stdout.split()
    return any(int(pid) != os.getpid() for pid in out)


def throttle_worker(stop):
    """One duty cycle per period: wake every throttled app, then freeze each one
    again once it has had its share. Percentages are per app, so the stops are
    scheduled rather than done all at once.

    PIDs are re-read every few seconds, not every period: `pgrep` plus a `ps`
    sweep per app is far too much work to repeat twice a second. Of the pids
    an app's label matches, only the ones nettop has seen carrying traffic go
    into the cycle (CARRIERS): Cursor's editor keeps drawing while its
    extension hosts are held.

    `held` is what this thread stopped in the period it is in the middle of, and
    it is woken at the top of every iteration before anything else happens. The
    wake used to be implicit: the next period's schedule SIGCONTs whatever it is
    about to re-stop, which works right up until there is no next schedule. On
    2026-08-28 `resume-all` emptied throttled.json while 35 apps sat in the
    stopped half of their duty cycle; this loop read the empty file, took the
    `continue`, and left every one of them stopped with no record anywhere that
    they were. Cursor was one of them, and nothing could have woken it:
    unfreeze_throttled() reads the same file that had just been emptied."""
    pid_cache, cached_at = {}, 0.0
    held = []

    def release():
        # A pid some other path has frozen for real since we stopped it stays
        # stopped: a duty cycle must not undo a freeze that outranks it.
        # Everything else this loop stopped, it wakes.
        nonlocal held
        if not held:
            return
        owned = set()
        for e in read_paused().values():
            owned.update(e["pids"])
        signal_pids([p for p in held if p not in owned], signal.SIGCONT)
        held = []

    while not stop.is_set():
        # The wake used to be the first thing in the loop, which quietly made
        # every read below it part of the app's running half: config, the two
        # state files and, every five seconds, a pid refresh that costs three
        # pgrep runs. The period's clock starts after all of it now, so the
        # share an app gets is the share it was set to.
        cfg = load_config()
        period = max(0.5, min(5.0, float(cfg.get("throttle_period") or 4.0)))
        throttled = read_throttled() if cfg.get("enforce", True) else {}
        if not throttled:
            release()
            pid_cache, cached_at = {}, 0.0
            stop.wait(period)
            continue
        # An app that was deliberately paused stays paused. Throttling must not
        # quietly undo a pause or a low data freeze.
        paused = read_json(PAUSED_PATH) or {}
        names = [n for n in throttled if n not in paused]
        if time.time() - cached_at > 5:
            pid_cache = {n: carriers_among(app_pids(n)) for n in names}
            cached_at = time.time()
        schedule = {}
        for name in names:
            pids = pid_cache.get(name) or []
            if not pids:
                continue
            pct = max(1, min(95, int((throttled[name] or {}).get("pct", 25))))
            schedule.setdefault(round(period * pct / 100, 3), []).append(pids)
        if not schedule:
            release()
            stop.wait(period)
            continue
        started = time.time()
        release()
        for pids in schedule.values():
            for group in pids:
                signal_pids(group, signal.SIGCONT)
        for at in sorted(schedule):
            stop.wait(max(0.0, started + at - time.time()))
            for group in schedule[at]:
                held.extend(signal_pids(group, signal.SIGSTOP))
        stop.wait(max(0.0, started + period - time.time()))
    signal_pids(held, signal.SIGCONT)
    unfreeze_throttled()


def start_throttle_worker():
    """Started by the daemon, which is the only long-lived process that can hold
    a duty cycle. Recovers first: anything left throttled by a daemon that died
    mid-period is stopped right now and needs waking before the cycle resumes.
    Measured: SIGKILL leaves the app frozen roughly as often as the duty cycle
    says it should, and the restart releases it every time."""
    unfreeze_throttled()
    stop = threading.Event()
    threading.Thread(target=throttle_worker, args=(stop,), daemon=True).start()

    def bail(signum=None, frame=None):
        stop.set()
        unfreeze_throttled()
        if signum is not None:
            sys.exit(0)

    atexit.register(bail)
    # launchd stops the daemon with SIGTERM, whose default handler skips both
    # `finally` and atexit. Without this every throttled app stays frozen.
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        with contextlib.suppress(ValueError, OSError):
            signal.signal(sig, bail)
    return stop


def throttle(app, pct=None):
    """`netmeter throttle APP [--pct N]` / `throttle APP off` / `throttle off` /
    bare `throttle` for status."""
    cfg = load_config()
    current = read_throttled()
    if app is None:
        if not current:
            print("Nothing is throttled.")
            return
        for name, v in sorted(current.items()):
            why = "" if (v or {}).get("reason") == "manual" else f" (via {v['reason']})"
            print(f"{name}: {(v or {}).get('pct', 25)}%{why}")
        if not daemon_running():
            print("The daemon is not running, so nothing is enforcing these.")
        return
    if app == "off":
        for name in current:
            signal_app(name, signal.SIGCONT)
        save_json(THROTTLED_PATH, {})
        print(f"Throttling off. Released {len(current)} app(s).")
        return
    name = canonical(app)
    if pct == 0:
        signal_app(name, signal.SIGCONT)
        set_throttled(name, 0)
        print(f"Throttling off for {name}.")
        return
    pct = max(1, min(95, int(pct if pct is not None else cfg.get("throttle_pct") or 25)))
    n = len(app_pids(name))
    set_throttled(name, pct, "manual")
    if not n:
        print(f"No running processes match '{app}', throttle saved, it applies "
              f"as soon as the app starts.")
    else:
        print(f"Throttling {name} to {pct}% ({n} process(es)). It keeps working, "
              f"just slower. Lift it with: netmeter throttle {app} off")
    if not daemon_running():
        print("Warning: the daemon is not running, so nothing will enforce this. "
              "Start it with `netmeter start`.")


def status(name):
    pids = app_pids(name)
    if not pids:
        print("not running")
        return
    # Check the throttle first: a throttled app's ps state flickers between T
    # and S with the duty cycle, so reading ps would answer a coin flip.
    t = read_throttled().get(canonical(name))
    if t:
        print(f"throttled ({t.get('pct', 25)}%)")
        return
    out = subprocess.run(["ps", "-o", "stat=", "-p", ",".join(map(str, pids))],
                         capture_output=True, text=True).stdout
    print("paused" if any(s.startswith("T") for s in out.split()) else "running")


def background_freeze(cfg=None):
    """Stop the daemons that fetch things nobody asked for. Frozen outright
    rather than ramped: a ramp exists so an app's in-flight work can finish, and
    the in-flight work here is the download being stopped. Returns what it froze
    this call, so the daemon can be quiet about the ones already down."""
    cfg = cfg or load_config()
    if not cfg.get("lowdata_background", True) or not cfg.get("enforce", True):
        return []
    already = read_paused()
    frozen = []
    for name in sorted(BACKGROUND_DOWNLOADS):
        if name in already:
            continue
        pids = signal_app(name, signal.SIGSTOP)
        if pids:
            set_paused(name, True, "lowdata", pids)
            frozen.append(name)
    return frozen


def background_lift():
    for name in BACKGROUND_DOWNLOADS:
        signal_app(name, signal.SIGCONT)
        set_paused(name, False)


# The auto-update preferences worth flipping, as (domain, key, value-while-low).
# Only user-domain keys, because those are the ones that take effect without
# sudo: the system's own update schedule lives in a root-owned plist, so
# `lowdata on` names the command for it rather than pretending it can.
UPDATE_PREFS = [
    ("com.apple.commerce", "AutoUpdate", "false"),
    ("com.apple.commerce", "AutoUpdateRestartRequired", "false"),
    ("com.google.Keystone.Agent", "checkInterval", "0"),
]


def _defaults_read(domain, key):
    out = subprocess.run(["defaults", "read", domain, key],
                         capture_output=True, text=True)
    return out.stdout.strip() if out.returncode == 0 else None


def update_prefs_apply(cfg):
    """Turn the auto-updaters off politely, remembering what they were.

    Freezing an updater stops this download; telling it not to check stops the
    next one, and stops the catch-up burst the moment low data comes off. Both,
    because neither is enough alone."""
    if not cfg.get("update_prefs", True):
        return []
    saved, changed = {}, []
    for domain, key, value in UPDATE_PREFS:
        prev = _defaults_read(domain, key)
        saved[f"{domain}/{key}"] = prev
        kind = "-int" if value.isdigit() else "-bool"
        r = subprocess.run(["defaults", "write", domain, key, kind, value],
                           capture_output=True, text=True)
        if r.returncode == 0:
            changed.append(f"{domain} {key}")
    save_json(UPDATE_PREFS_PATH, saved)
    return changed


def update_prefs_restore():
    """Put back exactly what was there, including "there was nothing here"."""
    saved = read_json(UPDATE_PREFS_PATH)
    if not saved:
        return 0
    n = 0
    for domain, key, _ in UPDATE_PREFS:
        prev = saved.get(f"{domain}/{key}")
        if prev is None:
            subprocess.run(["defaults", "delete", domain, key],
                           capture_output=True, text=True)
        else:
            kind = "-int" if prev.lstrip("-").isdigit() else "-string"
            subprocess.run(["defaults", "write", domain, key, kind, prev],
                           capture_output=True, text=True)
        n += 1
    with contextlib.suppress(OSError):
        os.remove(UPDATE_PREFS_PATH)
    return n


def lowdata_apply(cfg):
    """The acting half of `lowdata on`: freeze the freeze list, throttle the
    throttle list. Split out so a network profile switching the mode on behaves
    exactly like typing the command. Returns the pct it throttled to."""
    pct = max(1, min(95, int(cfg.get("throttle_pct") or 25)))
    if not cfg.get("enforce", True):
        log("low data: set, but monitor only is on, so nothing is held")
        return pct
    for app in cfg["lowdata_apps"]:
        pause(app, quiet=True)
    for app in cfg.get("lowdata_throttle") or []:
        set_throttled(canonical(app), pct, "lowdata")
    background_freeze(cfg)
    update_prefs_apply(cfg)
    return pct


def lowdata_lift(cfg):
    """The acting half of `lowdata off`. Returns how many throttles it lifted."""
    for app in cfg["lowdata_apps"]:
        signal_app(app, signal.SIGCONT)
        set_paused(canonical(app), False)
    background_lift()
    update_prefs_restore()
    return unthrottle_reason("lowdata")


def lowdata(action):
    cfg = load_config()
    if action == "on":
        cfg = update_config(lowdata=True)
        log("low data: on (by hand)")
        pct = lowdata_apply(cfg)
        if not cfg.get("enforce", True):
            print("Low data mode is set, but monitor only is on: nothing is "
                  "held. Lift it with: netmeter enforce on")
            return
        frozen = f" Frozen: {', '.join(cfg['lowdata_apps'])}." if cfg["lowdata_apps"] else ""
        slowed = (f" Throttled to {pct}%: {', '.join(cfg['lowdata_throttle'])}."
                  if cfg.get("lowdata_throttle") else "")
        bg = (" Background downloads stopped (updates, App Store, iCloud, assets)."
              if cfg.get("lowdata_background", True) else "")
        prefs = (" Auto-update checks off." if cfg.get("update_prefs", True) else "")
        print(f"Low data mode ON.{frozen}{slowed}{bg}{prefs} You'll get a "
              f"notification every {cfg['notify_every_mb']} MB of session data.")
        if cfg.get("update_prefs", True):
            # The system's own update schedule lives in a root-owned plist, so
            # this is the one piece that cannot be done from here. Say so rather
            # than leaving the impression it was handled.
            print("  macOS system updates need root to pause: "
                  "sudo softwareupdate --schedule off")
    elif action == "off":
        cfg = update_config(lowdata=False)
        log("low data: off (by hand)")
        n = lowdata_lift(cfg)
        tail = f" {n} throttle(s) lifted." if n else ""
        print(f"Low data mode OFF. Apps unfrozen, background downloads and "
              f"auto-update checks restored.{tail}")
    else:
        print("on" if cfg["lowdata"] else "off")


# --- per-network profiles ------------------------------------------------
# A network can carry its own low data settings: join the hotspot and the mode
# comes on by itself, throttles and burst cap included; leave and what was
# there before comes back. The point is that the hotspot behind you should not
# depend on remembering to flip a mode. Networks are identified by gateway MAC,
# the same signal the tether counter trusts. profile.json is the stint memory:
# which MAC the profile was applied for, what it applied, and what the settings
# were before. It lives on disk so a daemon restart mid-stint still knows what
# to put back. One rule governs the stint: a manual change while connected
# stands. The daemon acts only when the MAC changes, so `lowdata off` typed on
# a profiled network stays off until the network is left and rejoined.

# The settings a profile may pin. Deliberately just the lowdata family: the
# profile is "how careful should this network make me", not a second config.
PROFILE_KEYS = ("lowdata", "lowdata_apps", "lowdata_throttle",
                "throttle_pct", "burst_cap_mb")

# What network memory remembers on its own: the mode switches, and nothing else.
# It used to remember the whole profile family, which read well until the lists
# started travelling. Every remembered network kept its own copy of
# lowdata_throttle, throttle_pct and burst_cap_mb as they stood the last time
# you were there, so editing the throttle list at home and then walking into a
# cafe last visited in July restored July's list over it, silently, with no
# event anyone would connect to the edit. Found 2026-08-31 with five remembered
# networks all holding a stale copy of the same three settings.
#
# The rule now: memory answers "was this mode on here", config answers "what
# does this mode do". A profile is the deliberate exception, because pinning one
# is an act rather than a side effect, so PROFILE_KEYS still spans the family.
MEMORY_KEYS = ("lowdata", "pause_all")

# Everything a stint may put in place, from either source. profile_apply walks
# this rather than MEMORY_KEYS, which is what lets a profile keep pinning the
# settings memory no longer touches.
APPLY_KEYS = tuple(dict.fromkeys(PROFILE_KEYS + MEMORY_KEYS))


def memory_settings(entry):
    """A remembered network's settings, narrowed to what memory now speaks for.

    Entries written before 2026-08-31 carry the full family. They are trimmed on
    disk by migrate_state(), but this is the belt to that braces: an old entry
    that arrives from anywhere still applies as switches only."""
    st = (entry or {}).get("settings") or {}
    return {k: st[k] for k in MEMORY_KEYS if k in st}


def pause_all_sync(cfg, overlay):
    """Lift Pause All's freezes when an overlay turns the mode off or changes
    which apps it allows. The daemon's next tick re-freezes under the new rules."""
    if not cfg.get("pause_all"):
        return
    if not overlay.get("pause_all", True) or \
            overlay.get("pause_all_allow", cfg["pause_all_allow"]) != cfg["pause_all_allow"]:
        resume_reason("all")


def profile_apply(mac, prof):
    """Apply a profile's settings and remember what they replaced. The stint
    file keeps the applied overlay alongside the saved values: on restore, only
    keys still holding the profile's value go back, so a setting changed by
    hand mid-stint is Sean's, not the profile's, and survives the departure.
    The overlay holds only the keys that actually differ, so joining a network
    whose settings already match is a silent no-op rather than a lift-and-
    refreeze blip with a notification on top. Returns True when config moved."""
    cfg = load_config()
    settings = prof.get("settings") or {}
    overlay = {k: settings[k] for k in APPLY_KEYS
               if k in settings and cfg.get(k, DEFAULT_CONFIG[k]) != settings[k]}
    saved = {k: cfg.get(k, DEFAULT_CONFIG[k]) for k in overlay}
    save_json(PROFILE_PATH, {"mac": mac, "name": prof.get("name", ""),
                             "applied": overlay, "saved": saved})
    if not overlay:
        return False
    if cfg["lowdata"]:
        lowdata_lift(cfg)   # clean slate: the profile may freeze a different list
    pause_all_sync(cfg, overlay)
    cfg = update_config(**overlay)
    if cfg["lowdata"]:
        lowdata_apply(cfg)
    kind = "settings remembered" if prof.get("auto") else "network profile applied"
    allowed = cfg.get("pause_all_allow") or []
    tail = (f", pause all on ({len(allowed)} allowed)"
            if cfg.get("pause_all") else "")
    msg = (f"On {prof.get('name') or mac}: {kind}, "
           f"low data {'on' if cfg['lowdata'] else 'off'}{tail}")
    log(f"network: {msg}")
    notify(msg)
    return True


def profile_restore(stint):
    """Put back what the profile changed, honoring mid-stint manual edits."""
    applied, saved = stint.get("applied") or {}, stint.get("saved") or {}
    cfg = load_config()
    back = {k: v for k, v in saved.items() if cfg.get(k) == applied.get(k)}
    if cfg["lowdata"]:
        lowdata_lift(cfg)   # lift with the profile-era lists before they change back
    pause_all_sync(cfg, back)
    if back:
        cfg = update_config(**back)
    if cfg["lowdata"]:
        lowdata_apply(cfg)
    log(f"network: left {stint.get('name') or stint.get('mac', '')}, "
        f"settings restored, low data {'on' if cfg['lowdata'] else 'off'}")
    notify(f"Left {stint.get('name') or stint.get('mac', '')}: settings restored")


def network_remember(cfg, mac, ip=None):
    """One entry of memory per network: the mode settings as they stand, first
    written on join and refreshed as they change, so rejoining a known network
    can bring back how it was last used. Named after the explicit profile where
    one exists; otherwise the MAC is the name. Skips the write when nothing
    moved, which is every tick but the interesting ones."""
    settings = {k: cfg.get(k, DEFAULT_CONFIG[k]) for k in MEMORY_KEYS}
    nets = read_json(NETWORKS_PATH) or {}
    entry = dict(nets.get(mac) or {})
    today = datetime.date.today().isoformat()
    prof = (cfg.get("network_profiles") or {}).get(mac)
    name = (prof or {}).get("name") or entry.get("name", "")
    if (entry.get("settings") == settings and entry.get("last_seen") == today
            and entry.get("name", "") == name
            and (not ip or entry.get("router") == ip)):
        return
    # "changed" is the day the switches last moved, as against "last_seen",
    # the day we were last here. `networks` prints both, because "low data on,
    # set in April" and "low data on, set this morning" are different claims
    # about how much the entry should be trusted.
    if entry.get("settings") != settings:
        entry["changed"] = today
    entry.update({"settings": settings, "last_seen": today, "name": name})
    entry.setdefault("changed", today)
    if ip:
        entry["router"] = ip
    nets[mac] = entry
    save_json(NETWORKS_PATH, nets)


def profile_check(cfg, gw_mac, gw_ip=None):
    """Called once per daemon tick with the MAC already read for the tether
    counter. Returns True when it rewrote config, so the caller reloads.

    A None MAC means the route was unreadable, not that the network changed:
    wi-fi blips read as None for a beat, and treating one as a departure would
    restore-and-reapply around every blip, quietly undoing a manual override
    mid-stint. Unknown holds the stint; only a definite different MAC ends it.

    The stint file now tracks every network, not just profiled ones: a bare
    stint ({"applied": {}}) marks where we are so that leaving it is a real
    event, which is what lets memory snapshot the settings a stint ends with."""
    if gw_mac is None:
        return False
    remember = bool(cfg.get("remember_networks", True))
    stint = read_json(PROFILE_PATH) or {}
    if stint.get("mac") == gw_mac:
        # Same stint: manual changes stand until we leave, and memory keeps
        # up with them so the next join starts where this stint ends.
        if remember:
            network_remember(cfg, gw_mac, gw_ip)
        return False
    changed = False
    if stint.get("mac"):
        if remember:
            network_remember(cfg, stint["mac"])   # the stint's parting snapshot
        if stint.get("applied"):
            profile_restore(stint)
            changed = True
        with contextlib.suppress(OSError):
            os.remove(PROFILE_PATH)
        if changed:
            cfg = load_config()
    prof = (cfg.get("network_profiles") or {}).get(gw_mac)
    entry = ((read_json(NETWORKS_PATH) or {}).get(gw_mac) or {}) if remember else {}
    mem = memory_settings(entry)
    if prof and mem:
        # The profile pins what it pins; memory answers for the rest. Without
        # the merge, a Pause All left on at the previous network sails straight
        # through a profiled join, because the profile only speaks lowdata.
        merged = dict(mem)
        merged.update(prof.get("settings") or {})
        prof = dict(prof, settings=merged)
    elif mem:
        prof = {"name": entry.get("name", ""), "settings": mem, "auto": True}
    if prof:
        if profile_apply(gw_mac, prof):
            changed = True
    else:
        save_json(PROFILE_PATH, {"mac": gw_mac, "name": "",
                                 "applied": {}, "saved": {}})
    if remember:
        cfg = load_config() if changed else cfg
        network_remember(cfg, gw_mac, gw_ip)
    return changed


def profile_here(name):
    """`netmeter profile-here NAME`, in the spirit of tether-here: get the
    modes how you want them first, then run this while connected, and this
    network applies them by itself from then on."""
    cfg = load_config()
    ip, gw = gateway_mac(cfg.get("wifi_if", "en0"))
    if not gw:
        print("Could not read the gateway MAC. Are you on wi-fi?")
        return
    settings = {k: cfg[k] for k in PROFILE_KEYS}
    profiles = dict(cfg.get("network_profiles") or {})
    profiles[gw] = {"name": name, "settings": settings}
    update_config(network_profiles=profiles)
    print(f"Pinned to this network (router {ip}, MAC {gw}) as '{name}': "
          f"{profile_summary(settings)}. Joining it applies these; leaving "
          f"restores what they replaced.")


def profile_summary(s):
    parts = [f"low data {'on' if s.get('lowdata') else 'off'}"]
    if s.get("lowdata_apps"):
        parts.append("freeze " + ", ".join(s["lowdata_apps"]))
    if s.get("lowdata_throttle"):
        parts.append(f"throttle {', '.join(s['lowdata_throttle'])} "
                     f"to {s.get('throttle_pct', 25)}%")
    if s.get("burst_cap_mb"):
        parts.append(f"burst cap {s['burst_cap_mb']} MB/min")
    if s.get("pause_all"):
        allowed = s.get("pause_all_allow") or []
        parts.append("pause all on, allowing "
                     + (", ".join(allowed) if allowed else "nothing"))
    return ", ".join(parts)


def profile_cmd(action, name):
    """`netmeter profile` lists, `netmeter profile rm NAME` forgets one."""
    cfg = load_config()
    profiles = cfg.get("network_profiles") or {}
    if action == "rm":
        if not name:
            print("Usage: netmeter profile rm NAME")
            return
        keep = {m: p for m, p in profiles.items() if p.get("name") != name}
        if len(keep) == len(profiles):
            print(f"No profile named '{name}'.")
            return
        update_config(network_profiles=keep)
        print(f"Forgot profile '{name}'. If it is applied right now it stays "
              f"applied until you leave the network.")
        return
    if not profiles:
        print("No network profiles. Set the modes how you want them, then run "
              "`netmeter profile-here NAME` while on the network.")
        return
    _, gw = gateway_mac(cfg.get("wifi_if", "en0"))
    stint = read_json(PROFILE_PATH) or {}
    for mac, prof in sorted(profiles.items(), key=lambda kv: kv[1].get("name", "")):
        # Every network writes a stint now, so the mac matching is not enough
        # to mean "this profile got applied"; the stint carrying the profile's
        # name is what says the apply path wrote it.
        applied = (stint.get("mac") == mac
                   and stint.get("name") == prof.get("name"))
        marks = [m for m, on in (("here now", mac == gw),
                                 ("applied", applied)) if on]
        tail = f"  [{', '.join(marks)}]" if marks else ""
        print(f"{prof.get('name', '?')}  (MAC {mac}): "
              f"{profile_summary(prof.get('settings') or {})}{tail}")


def networks_cmd(action, name, label=None):
    """`netmeter networks` lists every network the daemon remembers, `networks
    name MAC LABEL` names one, `networks rm NAME|MAC` forgets one, and
    `networks on|off` toggles the remembering."""
    if action in ("on", "off"):
        update_config(remember_networks=(action == "on"))
        if action == "on":
            print("Remembering networks: rejoining one brings back the modes "
                  "you last used there.")
        else:
            print("Not remembering networks. Existing entries stay listed but "
                  "nothing applies or updates; `netmeter networks on` resumes.")
        return
    nets = read_json(NETWORKS_PATH) or {}
    if action == "name":
        # Naming used to come only with profile-here, which also pins settings,
        # so a network you merely wanted to recognise had to be given a policy
        # too. SSIDs are location-gated and the MAC is not a name anyone reads,
        # which leaves this as the only way to make the list legible.
        if not name or not label:
            print("Usage: netmeter networks name MAC|OLDNAME LABEL\n"
                  "  (`netmeter networks` lists the MACs; the one marked "
                  "[here now] is this network)")
            return
        hits = [m for m, e in nets.items()
                if m == name or (e.get("name") or "") == name]
        if not hits:
            print(f"No remembered network '{name}'.")
            return
        for m in hits:
            nets[m]["name"] = label
        save_json(NETWORKS_PATH, nets)
        print(f"Named {len(hits)} network(s) '{label}'.")
        return
    if action == "rm":
        if not name:
            print("Usage: netmeter networks rm NAME|MAC")
            return
        keep = {m: e for m, e in nets.items()
                if m != name and (e.get("name") or "") != name}
        if len(keep) == len(nets):
            print(f"No remembered network named '{name}'.")
            return
        save_json(NETWORKS_PATH, keep)
        print(f"Forgot {len(nets) - len(keep)} network(s). The next join "
              f"starts from whatever settings you arrive with.")
        return
    cfg = load_config()
    on = cfg.get("remember_networks", True)
    if not nets:
        print("No networks remembered yet." if on else
              "No networks remembered, and remembering is off: "
              "`netmeter networks on` starts it.")
        return
    day_nets = load(datetime.date.today().isoformat()).get("nets") or {}
    print(f"Remembering is {'on' if on else 'off'}. Rejoining a network "
          f"below brings back the modes it lists. Data is today's:")
    _, gw = gateway_mac(cfg.get("wifi_if", "en0"))
    ranked = sorted(nets.items(),
                    key=lambda kv: kv[1].get("last_seen", ""), reverse=True)
    for mac, e in ranked:
        # An unnamed network's label is its MAC; don't say it twice.
        detail = [mac] if e.get("name") else []
        if e.get("router"):
            detail.append(f"router {e['router']}")
        label = e.get("name") or mac
        paren = f" ({', '.join(detail)})" if detail else ""
        here = "  [here now]" if mac == gw else ""
        seen = e.get("last_seen", "?")
        # The day the switches last moved, said out loud only when it is not
        # the day we were last here: an entry set months ago and merely walked
        # past since is a weaker claim than one set this morning.
        set_on = e.get("changed")
        when = f"last seen {seen}" + (f", set {set_on}"
                                      if set_on and set_on != seen else "")
        u = day_nets.get(mac) or {}
        moved = u.get("in", 0) + u.get("out", 0)
        print(f"  {label}{paren} · {fmt(moved)} · {when} · "
              f"{profile_summary(memory_settings(e))}{here}")

    # A network that has moved bytes but is not remembered still spent the
    # data, and leaving it out would make the column quietly not add up.
    stray = {m: u for m, u in day_nets.items()
             if m not in nets and (u.get("in", 0) + u.get("out", 0))}
    for mac, u in sorted(stray.items(),
                         key=lambda kv: -(kv[1].get("in", 0) + kv[1].get("out", 0))):
        print(f"  {u.get('name') or mac} · "
              f"{fmt(u.get('in', 0) + u.get('out', 0))} · not remembered")


def notify(text):
    subprocess.run(["osascript", "-e",
                    f'display notification "{text}" with title "netmeter"'],
                   capture_output=True)


WAKE_GAP = 30.0                # a tick this far from the last one is not a tick


def wake_check(state, now_ts, interval):
    """The seconds the daemon was not looking, or 0 for an ordinary tick.

    Ticks are ~5s apart. A minutes-wide gap means the lid was shut or the
    sampler wedged, and either way the counters on the other side of it measure
    an interval with a hole in the middle."""
    last = state.get("last_tick")
    state["last_tick"] = now_ts
    if last is None:
        return 0.0
    gap = now_ts - last
    return gap if gap > max(WAKE_GAP, interval * 4) else 0.0


def wake_reset(state, now_ts):
    """Forget every counter that measures an interval across the gap.

    The burst cap reads a minute bucket, the drain cap reads a window of them,
    and the tether counter reads the difference between two interface
    readings. Carried across a sleep, the first is stamped with a minute that
    has already passed, the second has a hole in it, and the third can charge a
    whole night of somebody else's network to this one. A skipped interval is
    the honest answer; a stale one is not."""
    state["bucket_min"] = int(now_ts // 60)
    state["bucket"] = {}
    state["capped"] = set()
    state["drained"] = {}
    state["wifi_prev"] = None


def wake_engage(cfg=None):
    """Apply what this network asks for now, not at the end of the tick.

    The most dangerous seconds of a metered day are the first ones after the
    lid opens: every sync client that queued work overnight starts at once,
    while the profile for the network the laptop woke up on has not applied
    yet. Enforcement used to sit at the bottom of the tick, a full sample
    behind the bytes. This runs the network check and the freezes first, off a
    fresh MAC read, so the rest of the tick counts a connection that is already
    being protected. Returns the config, reloaded if the profile rewrote it."""
    cfg = cfg or load_config()
    iface = cfg.get("wifi_if", "en0")
    gw_ip, gw_mac = gateway_mac(iface)
    try:
        if profile_check(cfg, gw_mac, gw_ip):
            cfg = load_config()
    except Exception as e:
        log(f"wake: profile check failed: {e}", exc=True)
    if cfg.get("lowdata") and cfg.get("enforce", True):
        for app in cfg.get("lowdata_apps") or []:
            signal_app(app, signal.SIGSTOP)
        for name in background_freeze(cfg):
            log(f"wake: stopped background downloader {name}")
    return cfg


def run_daemon(interval, ticks=None):
    """Stream `nettop -d`: each sample after the first reports per-interval deltas
    per process, so no baseline arithmetic is needed. (Per-process cumulative
    counters are NOT monotonic — they drop when sockets close — so computing our
    own deltas double-counted traffic.)"""
    state = {"date": None, "data": None, "notified_mb": None,
             "bucket_min": None, "bucket": {}, "capped": set(), "appends": 0,
             "drained": {}, "last_tick": None}
    blocks_done = 0
    throttle_stop = start_throttle_worker()
    # A daemon that just came up inherits whatever the last one left frozen.
    # Some of it will be stale, and one pass of the reconciler is what turns a
    # crashed run's leftovers back into running processes.
    with contextlib.suppress(Exception):
        reconcile_paused()

    def tick(rows):
        today = datetime.date.today().isoformat()
        if today != state["date"]:
            state["date"] = today
            state["data"] = load(today)
            if state["data"]["started"] is None:
                state["data"]["started"] = datetime.datetime.now().isoformat(timespec="seconds")
        data = state["data"]
        now_ts = time.time()
        # Before anything is counted: if the clock jumped, the machine slept.
        # Engage for wherever it woke up, and drop the interval counters that
        # now span the sleep. (Design item 3.)
        gap = wake_check(state, now_ts, interval)
        if gap:
            log(f"wake: {gap:.0f}s gap, re-checking the network before counting")
            # The part-minute on the near side of the sleep is real traffic
            # under a stamp that is still correct, so it goes to history rather
            # than in the bin; only the counters that would span the gap are
            # thrown away.
            if state["bucket"]:
                with contextlib.suppress(Exception):
                    append_recent(state["bucket_min"], state["bucket"])
            wake_reset(state, now_ts)
            with contextlib.suppress(Exception):
                wake_engage()
        tick_in = tick_out = 0
        active = set()
        tick_bytes = {}
        tick_io = {}          # {app: [in, out]}, for the tether's per-app tally
        for line in rows:
            row = parse_row(line)
            if row is None:
                continue
            name, pid, d_in, d_out = row
            # nettop occasionally emits a negative interval delta when a
            # counter resets mid-sample. Summed as-is it walks the daily totals
            # backwards, so clamp rather than trust it. (Seen 2026-08-19:
            # syspolicyd reported [0, -28].)
            d_in, d_out = max(0, d_in), max(0, d_out)
            if d_in or d_out:
                mark_carrier(pid, now_ts)
                label = friendly(name)
                t = data["apps"].setdefault(label, [0, 0])
                t[0] += d_in
                t[1] += d_out
                tick_in += d_in
                tick_out += d_out
                active.add(label)
                tick_bytes[label] = tick_bytes.get(label, 0) + d_in + d_out
                io = tick_io.setdefault(label, [0, 0])
                io[0] += d_in
                io[1] += d_out
                b = state["bucket"].setdefault(label, [0, 0])
                b[0] += d_in
                b[1] += d_out

        # Close the minute bucket when the clock rolls over, so the history file
        # is appended to once a minute rather than on every tick.
        minute = int(now_ts // 60)
        if state["bucket_min"] is None:
            state["bucket_min"] = minute
        elif minute != state["bucket_min"]:
            append_recent(state["bucket_min"], state["bucket"])
            state["bucket_min"], state["bucket"] = minute, {}
            state["capped"] = set()
            state["appends"] += 1
            prune_carriers(now_ts)
            # Once a minute is often enough to catch a relaunched app and cheap
            # enough not to matter: one ps per frozen app, and the list is short.
            cfg_now = load_config()
            reconcile_paused(cfg_now)
            if cfg_now["lowdata"] or state.get("tether_on"):
                win = max(2, int(cfg_now.get("drain_window_min") or 5))
                for name, moved in drain_check(cfg_now, state["drained"], minute):
                    log(f"cap: froze {name}, {fmt(moved)} over {win} min "
                        f"(drain cap {cfg_now['drain_cap_mb']} MB)")
                    notify(f"Froze {name}: {fmt(moved)} over {win} min "
                           f"(drain cap {cfg_now['drain_cap_mb']} MB). "
                           f"Resume with: netmeter resume {name}")
            if state["appends"] % 60 == 0:
                prune_recent()
        data["updated"] = datetime.datetime.now().isoformat(timespec="seconds")

        sess_apps, sess_started = session_totals(data)
        s_in = sum(v[0] for v in sess_apps.values())
        s_out = sum(v[1] for v in sess_apps.values())
        # nettop's deltas cover exactly one -s interval, so that is the right divisor.
        elapsed = max(interval, 0.001)
        cfg = load_config()

        # Tether cap accounting: raw interface bytes (headers included, so it
        # tracks what the carrier bills), counted only while the gateway MAC
        # matches a linked tether network.
        iface = cfg.get("wifi_if", "en0")
        gw_ip, gw_mac = gateway_mac(iface)
        macs = cfg.get("tether_gateway_macs") or []
        # Normalised, because `arp` prints 30:23:3:... and 30:23:03:... for the
        # same address depending on where it came from. A raw comparison here
        # is the same latent bug the link warning had: the counter would sit at
        # zero forever with a link that looks perfectly correct.
        linked = {mac_norm(m) for m in macs}
        tether_on = gw_mac is not None and mac_norm(gw_mac) in linked
        state["tether_on"] = tether_on
        wb = wifi_bytes(iface)
        prev = state.get("wifi_prev")
        state["wifi_prev"] = wb
        tether = load_tether(cfg)
        # The interface delta is read once and charged twice: to the network we
        # are actually on, always, and to the cap as well when that network is
        # the metered one. They cover the same period, so on the tether the two
        # numbers describe one span rather than disagreeing about it.
        d_in = d_out = 0
        if wb and prev:
            d_in = wb[0] - prev[0] if wb[0] >= prev[0] else wb[0]
            d_out = wb[1] - prev[1] if wb[1] >= prev[1] else wb[1]
        if gw_mac and (d_in or d_out or tick_io):
            nets_known = read_json(NETWORKS_PATH) or {}
            net_add(data, gw_mac, d_in, d_out, tick_io,
                    name=(nets_known.get(gw_mac) or {}).get("name", ""))
        # Only when the MAC actually read. A wi-fi blip returns None for a
        # beat, and taking that as "this network has moved nothing" would blink
        # the readout to zero and back, which is the same misread the stint
        # machinery already refuses to make.
        if gw_mac:
            e = (data.get("nets") or {}).get(gw_mac) or {}
            state["net_used"] = e.get("in", 0) + e.get("out", 0)
        if tether_on and wb and prev:
            t_in, t_out = d_in, d_out
            tether["in"] += t_in
            tether["out"] += t_out
            tether_attribute(tether, tick_io)
            cap = cfg.get("tether_cap_gb", 0) * GB
            if cap:
                pct = 100 * (tether["in"] + tether["out"]) / cap
                for mark in (50, 75, 90, 100):
                    if pct >= mark and tether.get("notified_pct", 0) < mark:
                        tether["notified_pct"] = mark
                        notify(f"{cfg.get('tether_name', 'tether')}: "
                               f"{fmt(tether['in'] + tether['out'])} of "
                               f"{cfg.get('tether_cap_gb')} GB used ({mark}%)")
            save_json(TETHER_PATH, tether)

        # Per-network profiles ride the same MAC read as the tether counter.
        # Wrapped hard: a profile bug must never take the sampler down with it,
        # and a failed check just means this tick behaves like the last one.
        try:
            if profile_check(cfg, gw_mac, gw_ip):
                cfg = load_config()   # the profile just rewrote config
        except Exception as e:
            log(f"profile check failed: {e}", exc=True)

        # After the network accounting, not before it: the per-network totals
        # live in this file now, and writing it a step too early left every
        # tick's last five seconds for the next one to pick up, or dropped
        # altogether on the way out.
        save_json(state_path(today), data)

        save_json(NOW_PATH, {
            "ts": now_ts,
            "down_bps": tick_in / elapsed,
            "up_bps": tick_out / elapsed,
            "session_in": s_in,
            "session_out": s_out,
            "session_started": sess_started,
            "tether_name": cfg.get("tether_name", ""),
            "tether_used": tether["in"] + tether["out"],
            "tether_cap_gb": cfg.get("tether_cap_gb", 0),
            "tether_on": tether_on,
            "tether_setup": bool(macs),
            "tether_warn": tether_link_warning(cfg, macs, tether, tether_on),
            # The bar's "always Low Data here" row needs to know which network
            # it is standing on; the profile lookup itself stays in config.json.
            "net_mac": gw_mac or "",
            # What this network has cost today, on the same clock as Today, so
            # the three scopes in the menu are three spans you can hold against
            # each other. The bar reads the per-app split, and every other
            # network seen today, straight out of the day file.
            "net_used": state.get("net_used", 0),
            "net_name": (read_json(NETWORKS_PATH) or {}).get(
                gw_mac or "", {}).get("name", ""),
            "tether_resets": tether_next_reset(
                datetime.date.fromisoformat(tether["period_start"])).isoformat(),
            # What is held and what is armed, as two lists of plain words, so
            # the menu can say "holding nothing" or name what it is holding.
            "holding": holding_now(cfg, tether_on)[0],
            "armed": holding_now(cfg, tether_on)[1],
        })
        # Monitor only: everything below this line is a hold, and none of it
        # runs. The count above it is untouched.
        enforce = bool(cfg.get("enforce", True))
        # Ramps first: an app that has reached the bottom of one gets frozen
        # this tick, before pause-all looks at what is still running.
        for name, landing in (ramp_step(cfg, tick_bytes) if enforce else []):
            log(f"ramp finished: {landing} {name}")
        if cfg.get("pause_all") and enforce:
            started = pause_all_apply(cfg, active)
            if started:
                what = 'stopping' if cfg.get('pause_all_hard') else 'slowing'
                log(f"pause all: {what} {', '.join(started)}")
                notify(f"Pause All is {what} {', '.join(started)}")
        # The burst cap is armed by the situation, not by the mode: a surprise
        # 100 MB costs the same whether or not Low Data happens to be on, and on
        # a metered network it is the only thing standing between a background
        # update and the bill. (Design item 4, 2026-08-24.)
        cap = cfg.get("burst_cap_mb") or 0
        if enforce and cap and cfg.get("burst_cap_on", True) \
                and (cfg["lowdata"] or tether_on):
            via = "low data" if cfg["lowdata"] else (cfg.get("tether_name")
                                                     or "metered network")
            for name, moved in burst_cap_check(state["bucket"], cap, state["capped"]):
                log(f"cap: froze {name}, {fmt(moved)} in under a minute "
                    f"(cap {cap} MB, armed by {via})")
                notify(f"Froze {name}: {fmt(moved)} in under a minute "
                       f"(cap {cap} MB, armed by {via}). "
                       f"Resume with: netmeter resume {name}")
        if cfg["lowdata"]:
            if enforce:
                for app in cfg["lowdata_apps"]:
                    signal_app(app, signal.SIGSTOP)
                # An updater that wakes up mid-stint has to go straight back down.
                for name in background_freeze(cfg):
                    log(f"low data: stopped background downloader {name}")
            step = cfg.get("notify_every_mb") or 0
            if step:
                total_mb = (s_in + s_out) / MB
                if state["notified_mb"] is None:
                    state["notified_mb"] = (total_mb // step) * step
                elif total_mb >= state["notified_mb"] + step:
                    state["notified_mb"] = (total_mb // step) * step
                    notify(f"Session has used {total_mb:.0f} MB")
        else:
            state["notified_mb"] = None

    def handle_block(rows):
        """One bad tick must not be a dead daemon. It used to be: anything
        raising in here escaped the read loop, unwound past the respawn, and
        left launchd to restart the process every few seconds with the reason
        going nowhere anyone would look. The count advances either way, so a
        bounded run still terminates."""
        nonlocal blocks_done
        try:
            tick(rows)
        except Exception:
            log("tick failed", exc=True)
        blocks_done += 1

    try:
        while ticks is None or blocks_done < ticks:
            cmd = ["nettop", "-P", "-x", "-d", "-s", str(max(1, int(interval))),
                   "-L", "0" if ticks is None else str(ticks + 1),
                   "-J", "bytes_in,bytes_out"]
            # Run under a pty (`script`), else nettop block-buffers and samples arrive bunched.
            proc = subprocess.Popen(["script", "-q", "/dev/null"] + cmd,
                                    stdout=subprocess.PIPE, text=True)
            block_idx = 0
            pending = []
            try:
                for line in proc.stdout:
                    if line.startswith(","):  # header row marks the start of a sample
                        if block_idx > 1 and pending:  # block 1 is cumulative; skip it
                            handle_block(pending)
                            if ticks is not None and blocks_done >= ticks:
                                proc.kill()
                                break
                        block_idx += 1
                        pending = []
                    else:
                        pending.append(line)
                else:
                    # nettop exited: flush the final block on bounded runs, then respawn/stop
                    if ticks is not None and block_idx > 1 and pending and blocks_done < ticks:
                        handle_block(pending)
            finally:
                proc.kill()
                proc.wait()
            if ticks is None:
                log(f"nettop exited (rc {proc.returncode}); respawning")
                time.sleep(interval)  # nettop died; breathe before respawning
    finally:
        throttle_stop.set()
        unfreeze_throttled()


def fmt(b):
    if b >= GB:
        return f"{b / GB:.2f} GB"
    if b >= MB:
        return f"{b / MB:.0f} MB"
    return f"{b / KB:.0f} KB"


def print_table(apps, header, top=None):
    """`top` caps the rows printed. TOTAL stays the total of everything, so a
    capped table never reads as though the rest of the traffic did not
    happen."""
    rows = sorted(apps.items(), key=lambda kv: kv[1][0] + kv[1][1], reverse=True)
    rows = [r for r in rows if r[1][0] + r[1][1] >= 10 * 1024]   # sub-10KB noise
    tot_in = sum(v[0] for v in apps.values())
    tot_out = sum(v[1] for v in apps.values())
    shown = rows if top is None else rows[:top]
    width = max([len(name) for name, _ in shown] + [len("TOTAL")])
    print(header)
    print(f"{'APP':<{width}}  {'DOWN':>10}  {'UP':>10}  {'TOTAL':>10}")
    for name, (b_in, b_out) in shown:
        print(f"{name:<{width}}  {fmt(b_in):>10}  {fmt(b_out):>10}  {fmt(b_in + b_out):>10}")
    rest = len(rows) - len(shown)
    if rest:
        print(f"{f'+ {rest} more':<{width}}")
    print(f"{'TOTAL':<{width}}  {fmt(tot_in):>10}  {fmt(tot_out):>10}  {fmt(tot_in + tot_out):>10}")


def show(date):
    data = load(date)
    if not data["apps"]:
        print(f"No data recorded for {date}. Is the daemon running?")
        print("  launchctl list | grep netmeter   # check")
        return
    print_table(data["apps"],
                f"netmeter — {date}  (recording since {data['started']}, updated {data['updated']})")
    if date == datetime.date.today().isoformat():
        sess_apps, started = session_totals(data)
        s_in = sum(v[0] for v in sess_apps.values())
        s_out = sum(v[1] for v in sess_apps.values())
        print(f"\nSession since {started}: ↓{fmt(s_in)} ↑{fmt(s_out)} "
              f"(total {fmt(s_in + s_out)}) — `netmeter session` for the breakdown")


def fmt_window(minutes):
    if minutes < 60:
        return f"{minutes}m"
    h, m = divmod(minutes, 60)
    return f"{h}h" if not m else f"{h}h {m}m"


def show_recent(minutes):
    apps = read_recent(minutes)
    if not apps:
        print(f"No traffic recorded in the last {fmt_window(minutes)}. "
              "The history only starts when the daemon does.")
        return
    rows = sorted(apps.items(), key=lambda kv: kv[1][0] + kv[1][1], reverse=True)
    total = sum(v[0] + v[1] for v in apps.values())
    width = max([len(n) for n, _ in rows[:12]] + [len("TOTAL")])
    print(f"netmeter, last {fmt_window(minutes)}  (total {fmt(total)}, "
          f"{fmt(total / (minutes * 60))}/s average)")
    for name, (b_in, b_out) in rows[:12]:
        both = b_in + b_out
        share = both / total if total else 0
        bar = "#" * max(1, round(share * 24))
        print(f"{name:<{width}}  {fmt(both):>10}  {100 * share:4.0f}%  {bar}")


def show_session():
    data = load(datetime.date.today().isoformat())
    apps, started = session_totals(data)
    if not apps:
        print("No session traffic yet.")
        return
    print_table(apps, f"netmeter session — since {started}")


