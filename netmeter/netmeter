#!/usr/bin/env python3
"""netmeter — per-app daily network totals for macOS (the monitoring half of Little Snitch/TripMode).

A small daemon samples `nettop` every few seconds, computes per-process deltas,
and accumulates them into per-app daily totals that survive process exits.
Data lives in ~/.netmeter/YYYY-MM-DD.json.

Usage:
  netmeter                show today's per-app totals and the session line
  netmeter show DATE      show a past day (YYYY-MM-DD)
  netmeter session        show per-app totals for the current session
  netmeter session reset  start a new session (e.g. when switching to tethering)
  netmeter pause APP      freeze an app (SIGSTOP) — e.g. `netmeter pause chrome`
  netmeter resume APP     unfreeze it (SIGCONT)
  netmeter throttle APP   slow an app to a share of its speed instead of freezing it,
                          e.g. `netmeter throttle claude --pct 25`. `throttle APP off`
                          lifts one, `throttle off` lifts all, bare `throttle` lists them
  netmeter status APP     throttled / paused / running / not running
  netmeter lowdata on     freeze the apps in config's lowdata_apps and keep them frozen,
                          throttle the apps in lowdata_throttle to throttle_pct,
                          freeze any app that moves burst_cap_mb inside one minute;
                          notify every notify_every_mb MB of session data
  netmeter lowdata off    lift low data mode and unfreeze
  netmeter profile-here NAME
                          pin the current lowdata settings (mode, freeze list,
                          throttle list, pct, burst cap) to this network, identified
                          by its gateway MAC: joining it applies them by itself,
                          leaving it restores what they replaced. A mode flipped by
                          hand while connected stands until you leave and rejoin
  netmeter profile        list per-network profiles; `profile rm NAME` forgets one
  netmeter solo APP       solo mode: only APP may use the network. Every other app that
                          tries to send or receive gets frozen, system daemons excepted
  netmeter solo off       lift solo mode and unfreeze whatever solo froze
  netmeter recent [MIN]   who spent the data over the last MIN minutes (default 60)
  netmeter display        menu bar display options: --rate on|off (live speed),
                          --total on|off (session total), --combine on|off (merge
                          the down and up rates). With both rate and total off the
                          bar item is just an up/down arrow
  netmeter start          run the sampling daemon in the foreground (launchd runs this)
  netmeter reset          zero out today's counters and the session

Config: ~/.netmeter/config.json
  {"lowdata_apps": ["chrome"], "lowdata_throttle": ["claude"], "throttle_pct": 25,
   "burst_cap_mb": 150, "notify_every_mb": 25,
   "network_profiles": {"<gateway MAC>": {"name": "...", "settings": {...}}}}
"""

import argparse
import atexit
import contextlib
import datetime
import fcntl
import json
import os
import re
import signal
import subprocess
import sys
import threading
import time

# Decimal units, deliberately. A carrier that sells a 50 GB plan means
# 50 x 10^9 bytes, so counting the cap in 2^30 gave 7.4% of phantom headroom:
# the "100% used" warning did not fire until roughly 3.7 GB past the real cap.
# Display follows the same units so the bar and the bill agree. (2026-08-19)
KB, MB, GB = 1000, 1000 ** 2, 1000 ** 3

STATE_DIR = os.path.expanduser("~/.netmeter")
NOW_PATH = os.path.join(STATE_DIR, "now.json")
SESSION_PATH = os.path.join(STATE_DIR, "session.json")
PAUSED_PATH = os.path.join(STATE_DIR, "paused.json")
THROTTLED_PATH = os.path.join(STATE_DIR, "throttled.json")
RECENT_PATH = os.path.join(STATE_DIR, "recent.jsonl")
TETHER_PATH = os.path.join(STATE_DIR, "tether.json")
PROFILE_PATH = os.path.join(STATE_DIR, "profile.json")
CONFIG_PATH = os.path.join(STATE_DIR, "config.json")

# lowdata_apps is empty by default: low data mode only watches and notifies.
# Add "chrome" (or any alias/pattern) to also freeze apps while the mode is on.
# Metered network: all personal values (name, cap, reset day, linked gateways)
# live in ~/.netmeter/config.json, set via `netmeter tether-config` and
# `netmeter tether-here`. The defaults here are deliberately empty.
DEFAULT_CONFIG = {
    "lowdata": False, "lowdata_apps": [], "notify_every_mb": 25,
    # lowdata_throttle is the middle setting between "leave it alone" and the
    # all-or-nothing freeze of lowdata_apps: apps here stay usable, just slow.
    # throttle_period is the duty cycle length in seconds; longer saves more
    # syscalls, shorter keeps a stalled TCP connection from backing off.
    "lowdata_throttle": [], "throttle_pct": 25, "throttle_period": 4.0,
    # burst_cap_mb is the hard stop, and it is the one that protects a monthly
    # cap. Throttling is a soft brake: a stopped process still has its socket
    # buffer filled for it by the kernel and drains the backlog the moment it
    # wakes, so a 25% duty cycle measured 63% of full speed against a real
    # transfer. Freezing an app that has moved burst_cap_mb inside one minute is
    # what actually stops a bulk download. Only armed while low data mode is on.
    "burst_cap_mb": 0,
    "solo": False, "solo_app": "",
    "combine_updown": False, "show_rate": True, "show_total": True,
    "recent_window": 60, "recent_open": True,
    "tether_name": "", "tether_cap_gb": 0, "tether_reset_day": 1,
    "tether_gateway_macs": [], "wifi_if": "en0",
    # network_profiles pins lowdata settings to a network, keyed by gateway MAC,
    # the identity the tether counter already trusts (reading the SSID needs
    # location permission, the router's MAC does not). Entries are
    # {"name": ..., "settings": {PROFILE_KEYS...}}, made by `profile-here`.
    "network_profiles": {},
}

# Freezing these breaks the machine (DNS, the window server, the terminal you
# would type `netmeter solo off` into) rather than saving data. The burst cap
# stops at this line and nothing else: an app moving 900 MB a minute is exactly
# what the cap is for, however inconvenient freezing it happens to be.
NEVER_FREEZE = {
    "kernel_task", "launchd", "WindowServer", "loginwindow", "Finder", "Dock",
    "SystemUIServer", "netmeter", "netmeter-bar", "Terminal", "iTerm2", "iTerm",
    "Ghostty", "Alacritty", "kitty", "Warp", "mDNSResponder", "configd",
    "networkd", "nsurlsessiond", "syspolicyd", "apsd", "cloudd", "trustd",
    "identityservice", "identityservicesd", "locationd", "bird", "timed",
    "softwareupdated", "symptomsd", "rapportd", "sharingd", "searchpartyd",
    "netbiosd", "com.apple.geod", "AssetCacheLocat", "parsec-fbf",
    "networkserviceproxy (Apple relay)", "python3", "ssh", "sshd",
}

# Solo mode spares one more thing: the running work sessions. Soloing Chrome to
# stop an updater helping itself to the hotspot should not also kill the terminal
# session doing the work, and until app_pids() learned to resolve the label it
# never could, because the CLI's process is named for its version and the SIGSTOP
# fell on nothing. Now that it lands, the exemption has to be written down.
# Throttling is the control for these, which is the whole reason it exists.
SOLO_PROTECT = NEVER_FREEZE | {"Claude Code"}

# nettop truncates process names; map the cryptic ones to readable labels.
FRIENDLY = [
    (re.compile(r"^\d+\.\d+\.\d+$"), "Claude Code"),          # CLI shows as its version, e.g. 2.1.220
    (re.compile(r"^Cursor Helper"), "Cursor"),
    (re.compile(r"^Google Chrome"), "Google Chrome"),
    (re.compile(r"^com\.apple\.Web"), "Safari (WebKit)"),
    (re.compile(r"^networkservicep"), "networkserviceproxy (Apple relay)"),
]

# Short names accepted by pause/resume/lowdata, mapped to pgrep -f patterns.
ALIASES = {
    "chrome": "Google Chrome",
    "safari": "Safari",
    "cursor": "Cursor",
    "spotify": "Spotify",
    "slack": "Slack",
    "whatsapp": "WhatsApp",
}


def friendly(name):
    for pat, label in FRIENDLY:
        if pat.match(name):
            return label
    return name


def state_path(date):
    return os.path.join(STATE_DIR, f"{date}.json")


def save_json(path, obj):
    """The temp name carries the pid. A shared `<path>.tmp` is what let two
    netmeter processes writing at the same moment interleave into an
    unparseable config.json, which read_json then swallowed, which made the
    next load_config() fall back to defaults and persist them: one Preferences
    Save wiped a linked tether network. Found 2026-08-19."""
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f)
    os.replace(tmp, path)


@contextlib.contextmanager
def locked(path):
    """Exclusive lock for a read-modify-write. The daemon and the CLI both edit
    config.json and paused.json, and an unlocked read-modify-write loses the
    other writer's change even when each individual write is atomic."""
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(path + ".lock", "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)


def update_config(**changes):
    """The only way config.json is written. Locked, and it refuses to answer a
    corrupt file with a fresh set of defaults: it recovers from config.json.bak
    and says so, because silently defaulting is what turned a transient race
    into lost settings."""
    with locked(CONFIG_PATH):
        raw, note = {}, ""
        if os.path.exists(CONFIG_PATH):
            try:
                with open(CONFIG_PATH) as f:
                    raw = json.load(f)
            except json.JSONDecodeError:
                os.replace(CONFIG_PATH, CONFIG_PATH + ".corrupt")
                raw = read_json(CONFIG_PATH + ".bak") or {}
                note = (f" (config.json was unreadable, kept as config.json.corrupt; "
                        f"recovered {'from config.json.bak' if raw else 'defaults'})")
        cfg = dict(DEFAULT_CONFIG)
        cfg.update(raw)
        cfg.update(changes)
        save_json(CONFIG_PATH, cfg)
        with contextlib.suppress(OSError):
            save_json(CONFIG_PATH + ".bak", cfg)
        if note:
            print("netmeter:" + note)
        return cfg


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return None


def load(date):
    return read_json(state_path(date)) or {
        "date": date, "started": None, "updated": None, "apps": {}}


RECENT_KEEP = 800          # minutes of history, a little over 13 hours


def append_recent(minute, apps):
    """One JSON object per line, one line per elapsed minute. Appending is O(1),
    which is why this is not the single rewritten blob the rest of the state
    uses: a rewrite every tick would be writing hundreds of KB a minute to keep
    a few dozen numbers."""
    if not apps:
        return
    with locked(RECENT_PATH):
        with open(RECENT_PATH, "a") as f:
            f.write(json.dumps({"m": minute, "a": apps}, separators=(",", ":")) + "\n")


def prune_recent():
    with locked(RECENT_PATH):
        try:
            with open(RECENT_PATH) as f:
                lines = f.readlines()
        except FileNotFoundError:
            return
        if len(lines) <= RECENT_KEEP * 2:
            return
        tmp = f"{RECENT_PATH}.{os.getpid()}.tmp"
        with open(tmp, "w") as f:
            f.writelines(lines[-RECENT_KEEP:])
        os.replace(tmp, RECENT_PATH)


def read_recent(window_minutes):
    """Per-app totals over the last `window_minutes` complete minutes."""
    cutoff = int(time.time() // 60) - window_minutes
    totals = {}
    try:
        with open(RECENT_PATH) as f:
            for line in f:
                try:
                    row = json.loads(line)
                except json.JSONDecodeError:
                    continue          # a torn final line, skip it
                if row.get("m", 0) <= cutoff:
                    continue
                for app, (d_in, d_out) in row.get("a", {}).items():
                    t = totals.setdefault(app, [0, 0])
                    t[0] += d_in
                    t[1] += d_out
    except FileNotFoundError:
        return {}
    return totals


def load_config():
    cfg = dict(DEFAULT_CONFIG)
    cfg.update(read_json(CONFIG_PATH) or {})
    return cfg


def parse_row(line):
    """One nettop CSV row -> (process_name, bytes_in, bytes_out), or None."""
    parts = line.split(",")
    if len(parts) < 3:
        return None
    m = re.match(r"^(.+)\.(\d+)$", parts[0])
    if not m:
        return None
    try:
        return m.group(1), int(parts[1]), int(parts[2])
    except ValueError:
        return None


def session_totals(data):
    """Per-app bytes since the last session reset (or since recording began today)."""
    sess = read_json(SESSION_PATH)
    live = sess is not None and sess.get("date") == data["date"]
    snap = sess["snapshot"] if live else {}
    apps = {}
    for app, v in data["apps"].items():
        s = snap.get(app, [0, 0])
        d_in, d_out = max(0, v[0] - s[0]), max(0, v[1] - s[1])
        if d_in or d_out:
            apps[app] = [d_in, d_out]
    started = sess["started"] if live else data["started"]
    return apps, started


def reset_session():
    today = datetime.date.today().isoformat()
    data = load(today)
    save_json(SESSION_PATH, {
        "started": datetime.datetime.now().isoformat(timespec="seconds"),
        "date": today,
        "snapshot": {k: list(v) for k, v in data["apps"].items()},
    })
    print("Session reset. Counting from zero now.")


def canonical(name):
    return ALIASES.get(name.lower(), name)


def gateway_mac(iface):
    """(router_ip, router_mac) of the current network, from DHCP + ARP.
    Works without location permission, unlike reading the SSID."""
    ip = subprocess.run(["ipconfig", "getoption", iface, "router"],
                        capture_output=True, text=True).stdout.strip()
    if not ip:
        return None, None
    arp = subprocess.run(["arp", "-n", ip], capture_output=True, text=True).stdout
    m = re.search(r" at ([0-9a-f:]+)", arp)
    return ip, (m.group(1) if m else None)


def wifi_bytes(iface):
    """Cumulative (in, out) bytes for the interface since boot, from netstat."""
    out = subprocess.run(["netstat", "-ib", "-I", iface],
                         capture_output=True, text=True).stdout
    for line in out.splitlines():
        p = line.split()
        if len(p) >= 11 and p[2].startswith("<Link"):
            return int(p[6]), int(p[9])
    return None


def tether_period_start(reset_day, today=None):
    t = today or datetime.date.today()
    if t.day >= reset_day:
        return datetime.date(t.year, t.month, reset_day)
    prev_last = t.replace(day=1) - datetime.timedelta(days=1)
    return datetime.date(prev_last.year, prev_last.month, reset_day)


def tether_next_reset(period_start):
    y, m = period_start.year, period_start.month + 1
    if m > 12:
        y, m = y + 1, 1
    return datetime.date(y, m, period_start.day)


def load_tether(cfg):
    t = read_json(TETHER_PATH) or {}
    ps = tether_period_start(cfg["tether_reset_day"]).isoformat()
    if t.get("period_start") != ps:
        t = {"period_start": ps, "in": 0, "out": 0, "notified_pct": 0}
    return t


def ps_ucomm():
    """(pid, ucomm) for every process. ucomm is the short accounting name, the
    same one nettop reports and the only one `pgrep -x` matches against."""
    out = subprocess.run(["ps", "-axo", "pid=,ucomm="],
                         capture_output=True, text=True).stdout
    rows = []
    for line in out.splitlines():
        pid, _, ucomm = line.strip().partition(" ")
        if pid.isdigit():
            rows.append((int(pid), ucomm.strip()))
    return rows


def app_pids(name):
    """Match by exact process name AND by command line, so both an app's main
    process (e.g. 'Granola') and its helpers ('Granola Helper') are caught.

    Labels that exist only because FRIENDLY renamed something need that regex
    run in reverse, else the table shows an app the signals cannot reach. The
    Claude Code CLI is the case in point: its process name is its version, so
    `pgrep -x "Claude Code"` matches nothing at all and `pgrep -f claude` would
    sweep in every helper of the desktop app instead."""
    pattern = canonical(name)
    pids = set()
    for args in (["-x", pattern], ["-f", pattern]):
        out = subprocess.run(["pgrep"] + args, capture_output=True, text=True).stdout
        pids.update(int(p) for p in out.split())
    for pat, label in FRIENDLY:
        if label == pattern:
            pids.update(pid for pid, ucomm in ps_ucomm() if pat.match(ucomm))
    pids -= {os.getpid(), os.getppid(), 1}
    return sorted(pids)


def set_paused(name, val, reason="manual"):
    """paused.json maps app -> reason ("manual", "lowdata", "solo"). The reason is
    what lets `solo off` unfreeze exactly what solo froze and nothing else. Older
    files stored `true`; anything truthy still reads as paused."""
    with locked(PAUSED_PATH):
        p = read_json(PAUSED_PATH) or {}
        if val:
            p[name] = reason
        else:
            p.pop(name, None)
        save_json(PAUSED_PATH, p)


def signal_pids(pids, sig):
    for pid in pids:
        with contextlib.suppress(ProcessLookupError, PermissionError):
            os.kill(pid, sig)
    return len(pids)


def signal_app(name, sig):
    return signal_pids(app_pids(name), sig)


def pause(name, quiet=False, reason="manual"):
    n = signal_app(name, signal.SIGSTOP)
    if n:
        set_paused(canonical(name), True, reason)
    if quiet:
        return
    if n:
        print(f"Froze {n} process(es) matching '{name}'. The app's window will be "
              f"unresponsive until you run: netmeter resume {name}")
    else:
        print(f"No running processes match '{name}'.")


def resume(name):
    n = signal_app(name, signal.SIGCONT)
    set_paused(canonical(name), False)
    # Resume means "leave this app alone", so it lifts a throttle too. Without
    # this the SIGCONT is undone by the next duty cycle a second later.
    set_throttled(canonical(name), 0)
    if n:
        print(f"Resumed {n} process(es) matching '{name}'.")
        cfg = load_config()
        if cfg["lowdata"]:
            print("Note: low data mode is still ON, the daemon will re-freeze it. "
                  "Run: netmeter lowdata off")
        if cfg["solo"] and canonical(name) != canonical(cfg.get("solo_app", "")):
            print(f"Note: solo mode is still ON ({cfg['solo_app']} only), the daemon "
                  "will re-freeze it. Run: netmeter solo off")
    else:
        print(f"No running processes match '{name}'.")


def resume_all():
    paused = read_json(PAUSED_PATH) or {}
    throttled = read_throttled()
    for name in set(paused) | set(throttled):
        signal_app(name, signal.SIGCONT)
    save_json(PAUSED_PATH, {})
    save_json(THROTTLED_PATH, {})
    n = len(set(paused) | set(throttled))
    print(f"Resumed {n} app(s)." if n else "Nothing was paused or throttled.")


def resume_reason(reason):
    """Unfreeze only the apps a given mode froze. Returns how many."""
    paused = read_json(PAUSED_PATH) or {}
    names = [n for n, why in paused.items() if why == reason]
    for name in names:
        signal_app(name, signal.SIGCONT)
        set_paused(name, False)
    return len(names)


# --- throttle -----------------------------------------------------------
# Pause is all-or-nothing, and for some apps that makes it useless: freezing a
# running work session is not a saving, it is a stall you have to undo by hand.
# (The menu bar knows this: Claude Code is in its PAUSE_DENY list for exactly
# that reason.) Throttling duty-cycles SIGSTOP/SIGCONT instead: an app set to
# 25% runs for a quarter of each period and is frozen for the rest. Nothing
# rate-limits the socket directly; TCP does it, because a stopped process stops
# draining its receive buffer, the window closes, and the sender backs off. The
# transfer slows down rather than failing, which is the whole point.


def read_throttled():
    return read_json(THROTTLED_PATH) or {}


def set_throttled(name, pct, reason="manual"):
    """throttled.json maps app -> {"pct", "reason"}, mirroring paused.json so
    `lowdata off` can lift exactly what low data mode throttled."""
    with locked(THROTTLED_PATH):
        t = read_json(THROTTLED_PATH) or {}
        if pct:
            t[name] = {"pct": int(pct), "reason": reason}
        else:
            t.pop(name, None)
        save_json(THROTTLED_PATH, t)


def unfreeze_throttled():
    """A throttled app is stopped for most of every period, so a daemon that dies
    mid-cycle leaves it stopped. Called on the way out, which covers every exit
    that runs code, and on the way in, which is what covers the one that does
    not: SIGKILL cannot be handled, so a killed daemon really does leave the app
    frozen until launchd's KeepAlive restarts it a second later and this runs."""
    t = read_json(THROTTLED_PATH) or {}
    for name in t:
        signal_app(name, signal.SIGCONT)
    return len(t)


def unthrottle_reason(reason):
    """Lift only the throttles a given mode applied. Returns how many."""
    t = read_json(THROTTLED_PATH) or {}
    names = [n for n, v in t.items() if (v or {}).get("reason") == reason]
    for name in names:
        signal_app(name, signal.SIGCONT)
        set_throttled(name, 0)
    return len(names)


def burst_cap_check(bucket, cap_mb, already):
    """Freeze anything that has moved more than cap_mb inside the current minute.

    This is the backstop the throttle cannot be. A 953 MB minute is not a session
    ramping up, it is a bulk transfer nobody asked for, and the only thing that
    reliably stops one is taking the process off the CPU. The daemon already
    accumulates a per-app bucket for the history file, so the cap reads that
    instead of keeping a second window. `already` is the set of apps caught this
    minute, so one breach is one freeze rather than one per tick."""
    frozen = []
    limit = cap_mb * MB
    for name, (d_in, d_out) in list(bucket.items()):
        moved = d_in + d_out
        if name in already or name in NEVER_FREEZE or moved < limit:
            continue
        already.add(name)
        if signal_app(name, signal.SIGSTOP):
            set_paused(name, True, "cap")
            frozen.append((name, moved))
    return frozen


def daemon_running():
    out = subprocess.run(["pgrep", "-f", "netmeter start"],
                         capture_output=True, text=True).stdout.split()
    return any(int(pid) != os.getpid() for pid in out)


def throttle_worker(stop):
    """One duty cycle per period: wake every throttled app, then freeze each one
    again once it has had its share. Percentages are per app, so the stops are
    scheduled rather than done all at once.

    PIDs are re-read every few seconds, not every period: `pgrep` plus a `ps`
    sweep per app is far too much work to repeat twice a second."""
    pid_cache, cached_at = {}, 0.0
    while not stop.is_set():
        cfg = load_config()
        period = max(0.5, min(5.0, float(cfg.get("throttle_period") or 4.0)))
        throttled = read_throttled()
        if not throttled:
            pid_cache, cached_at = {}, 0.0
            stop.wait(period)
            continue
        # An app that was deliberately paused stays paused. Throttling must not
        # quietly undo a pause, a solo, or a low data freeze.
        paused = read_json(PAUSED_PATH) or {}
        names = [n for n in throttled if n not in paused]
        if time.time() - cached_at > 5:
            pid_cache = {n: app_pids(n) for n in names}
            cached_at = time.time()
        schedule = {}
        for name in names:
            pids = pid_cache.get(name) or []
            if not pids:
                continue
            pct = max(1, min(95, int((throttled[name] or {}).get("pct", 25))))
            schedule.setdefault(round(period * pct / 100, 3), []).append(pids)
        if not schedule:
            stop.wait(period)
            continue
        started = time.time()
        for pids in schedule.values():
            for group in pids:
                signal_pids(group, signal.SIGCONT)
        for at in sorted(schedule):
            stop.wait(max(0.0, started + at - time.time()))
            for group in schedule[at]:
                signal_pids(group, signal.SIGSTOP)
        stop.wait(max(0.0, started + period - time.time()))
    unfreeze_throttled()


def start_throttle_worker():
    """Started by the daemon, which is the only long-lived process that can hold
    a duty cycle. Recovers first: anything left throttled by a daemon that died
    mid-period is stopped right now and needs waking before the cycle resumes.
    Measured: SIGKILL leaves the app frozen roughly as often as the duty cycle
    says it should, and the restart releases it every time."""
    unfreeze_throttled()
    stop = threading.Event()
    threading.Thread(target=throttle_worker, args=(stop,), daemon=True).start()

    def bail(signum=None, frame=None):
        stop.set()
        unfreeze_throttled()
        if signum is not None:
            sys.exit(0)

    atexit.register(bail)
    # launchd stops the daemon with SIGTERM, whose default handler skips both
    # `finally` and atexit. Without this every throttled app stays frozen.
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        with contextlib.suppress(ValueError, OSError):
            signal.signal(sig, bail)
    return stop


def throttle(app, pct=None):
    """`netmeter throttle APP [--pct N]` / `throttle APP off` / `throttle off` /
    bare `throttle` for status."""
    cfg = load_config()
    current = read_throttled()
    if app is None:
        if not current:
            print("Nothing is throttled.")
            return
        for name, v in sorted(current.items()):
            why = "" if (v or {}).get("reason") == "manual" else f" (via {v['reason']})"
            print(f"{name}: {(v or {}).get('pct', 25)}%{why}")
        if not daemon_running():
            print("The daemon is not running, so nothing is enforcing these.")
        return
    if app == "off":
        for name in current:
            signal_app(name, signal.SIGCONT)
        save_json(THROTTLED_PATH, {})
        print(f"Throttling off. Released {len(current)} app(s).")
        return
    name = canonical(app)
    if pct == 0:
        signal_app(name, signal.SIGCONT)
        set_throttled(name, 0)
        print(f"Throttling off for {name}.")
        return
    pct = max(1, min(95, int(pct if pct is not None else cfg.get("throttle_pct") or 25)))
    n = len(app_pids(name))
    set_throttled(name, pct, "manual")
    if not n:
        print(f"No running processes match '{app}', throttle saved, it applies "
              f"as soon as the app starts.")
    else:
        print(f"Throttling {name} to {pct}% ({n} process(es)). It keeps working, "
              f"just slower. Lift it with: netmeter throttle {app} off")
    if not daemon_running():
        print("Warning: the daemon is not running, so nothing will enforce this. "
              "Start it with `netmeter start`.")


def solo_freeze(cfg, names):
    """Freeze every app in `names` that is neither the soloed app nor protected.
    Called on `solo on` with today's app list, and on every daemon tick with the
    apps that just moved bytes, which is what catches an app the moment it wakes
    up and tries to phone home."""
    target = canonical(cfg.get("solo_app", ""))
    already = read_json(PAUSED_PATH) or {}
    frozen = []
    for name in names:
        if name == target or name in SOLO_PROTECT or name in already:
            continue
        if signal_app(name, signal.SIGSTOP):
            set_paused(name, True, "solo")
            frozen.append(name)
    return frozen


def solo(app):
    """`netmeter solo APP` / `netmeter solo off` / `netmeter solo` for status."""
    cfg = load_config()
    if app is None:
        if cfg["solo"]:
            print(f"Solo mode ON: {cfg['solo_app']} only.")
        else:
            print("off")
        return
    if app == "off":
        update_config(solo=False)
        n = resume_reason("solo")
        print(f"Solo mode OFF. Resumed {n} app(s).")
        return
    cfg = update_config(solo=True, solo_app=canonical(app))
    today = load(datetime.date.today().isoformat())
    frozen = solo_freeze(cfg, list(today["apps"]))
    tail = f" Froze {len(frozen)}: {', '.join(frozen)}." if frozen else ""
    print(f"Solo mode ON: {cfg['solo_app']} only.{tail} Anything else that reaches "
          f"for the network gets frozen on sight. Lift it with `netmeter solo off`.")


def status(name):
    pids = app_pids(name)
    if not pids:
        print("not running")
        return
    # Check the throttle first: a throttled app's ps state flickers between T
    # and S with the duty cycle, so reading ps would answer a coin flip.
    t = read_throttled().get(canonical(name))
    if t:
        print(f"throttled ({t.get('pct', 25)}%)")
        return
    out = subprocess.run(["ps", "-o", "stat=", "-p", ",".join(map(str, pids))],
                         capture_output=True, text=True).stdout
    print("paused" if any(s.startswith("T") for s in out.split()) else "running")


def lowdata_apply(cfg):
    """The acting half of `lowdata on`: freeze the freeze list, throttle the
    throttle list. Split out so a network profile switching the mode on behaves
    exactly like typing the command. Returns the pct it throttled to."""
    for app in cfg["lowdata_apps"]:
        pause(app, quiet=True)
    pct = max(1, min(95, int(cfg.get("throttle_pct") or 25)))
    for app in cfg.get("lowdata_throttle") or []:
        set_throttled(canonical(app), pct, "lowdata")
    return pct


def lowdata_lift(cfg):
    """The acting half of `lowdata off`. Returns how many throttles it lifted."""
    for app in cfg["lowdata_apps"]:
        signal_app(app, signal.SIGCONT)
        set_paused(canonical(app), False)
    return unthrottle_reason("lowdata")


def lowdata(action):
    cfg = load_config()
    if action == "on":
        cfg = update_config(lowdata=True)
        pct = lowdata_apply(cfg)
        frozen = f" Frozen: {', '.join(cfg['lowdata_apps'])}." if cfg["lowdata_apps"] else ""
        slowed = (f" Throttled to {pct}%: {', '.join(cfg['lowdata_throttle'])}."
                  if cfg.get("lowdata_throttle") else "")
        print(f"Low data mode ON.{frozen}{slowed} You'll get a notification every "
              f"{cfg['notify_every_mb']} MB of session data.")
    elif action == "off":
        cfg = update_config(lowdata=False)
        n = lowdata_lift(cfg)
        tail = f" {n} throttle(s) lifted." if n else ""
        print(f"Low data mode OFF. Apps unfrozen.{tail}")
    else:
        print("on" if cfg["lowdata"] else "off")


# --- per-network profiles ------------------------------------------------
# A network can carry its own low data settings: join the hotspot and the mode
# comes on by itself, throttles and burst cap included; leave and what was
# there before comes back. The point is that the hotspot behind you should not
# depend on remembering to flip a mode. Networks are identified by gateway MAC,
# the same signal the tether counter trusts. profile.json is the stint memory:
# which MAC the profile was applied for, what it applied, and what the settings
# were before. It lives on disk so a daemon restart mid-stint still knows what
# to put back. One rule governs the stint: a manual change while connected
# stands. The daemon acts only when the MAC changes, so `lowdata off` typed on
# a profiled network stays off until the network is left and rejoined.

# The settings a profile may pin. Deliberately just the lowdata family: the
# profile is "how careful should this network make me", not a second config.
PROFILE_KEYS = ("lowdata", "lowdata_apps", "lowdata_throttle",
                "throttle_pct", "burst_cap_mb")


def profile_apply(mac, prof):
    """Apply a profile's settings and remember what they replaced. The stint
    file keeps the applied overlay alongside the saved values: on restore, only
    keys still holding the profile's value go back, so a setting changed by
    hand mid-stint is Sean's, not the profile's, and survives the departure."""
    cfg = load_config()
    settings = prof.get("settings") or {}
    overlay = {k: settings[k] for k in PROFILE_KEYS if k in settings}
    saved = {k: cfg.get(k, DEFAULT_CONFIG[k]) for k in overlay}
    if cfg["lowdata"]:
        lowdata_lift(cfg)   # clean slate: the profile may freeze a different list
    save_json(PROFILE_PATH, {"mac": mac, "name": prof.get("name", ""),
                             "applied": overlay, "saved": saved})
    if overlay:
        cfg = update_config(**overlay)
    if cfg["lowdata"]:
        lowdata_apply(cfg)
    notify(f"On {prof.get('name') or mac}: network profile applied, "
           f"low data {'on' if cfg['lowdata'] else 'off'}")


def profile_restore(stint):
    """Put back what the profile changed, honoring mid-stint manual edits."""
    applied, saved = stint.get("applied") or {}, stint.get("saved") or {}
    cfg = load_config()
    back = {k: v for k, v in saved.items() if cfg.get(k) == applied.get(k)}
    if cfg["lowdata"]:
        lowdata_lift(cfg)   # lift with the profile-era lists before they change back
    if back:
        cfg = update_config(**back)
    if cfg["lowdata"]:
        lowdata_apply(cfg)
    notify(f"Left {stint.get('name') or stint.get('mac', '')}: settings restored")


def profile_check(cfg, gw_mac):
    """Called once per daemon tick with the MAC already read for the tether
    counter. Returns True when it rewrote config, so the caller reloads.

    A None MAC means the route was unreadable, not that the network changed:
    wi-fi blips read as None for a beat, and treating one as a departure would
    restore-and-reapply around every blip, quietly undoing a manual override
    mid-stint. Unknown holds the stint; only a definite different MAC ends it."""
    if gw_mac is None:
        return False
    stint = read_json(PROFILE_PATH) or {}
    if stint.get("mac") == gw_mac:
        return False        # same stint: manual changes stand until we leave
    changed = False
    if stint:
        profile_restore(stint)
        with contextlib.suppress(OSError):
            os.remove(PROFILE_PATH)
        changed = True
    prof = (cfg.get("network_profiles") or {}).get(gw_mac)
    if prof:
        profile_apply(gw_mac, prof)
        changed = True
    return changed


def profile_here(name):
    """`netmeter profile-here NAME`, in the spirit of tether-here: get the
    modes how you want them first, then run this while connected, and this
    network applies them by itself from then on."""
    cfg = load_config()
    ip, gw = gateway_mac(cfg.get("wifi_if", "en0"))
    if not gw:
        print("Could not read the gateway MAC. Are you on wi-fi?")
        return
    settings = {k: cfg[k] for k in PROFILE_KEYS}
    profiles = dict(cfg.get("network_profiles") or {})
    profiles[gw] = {"name": name, "settings": settings}
    update_config(network_profiles=profiles)
    print(f"Pinned to this network (router {ip}, MAC {gw}) as '{name}': "
          f"{profile_summary(settings)}. Joining it applies these; leaving "
          f"restores what they replaced.")


def profile_summary(s):
    parts = [f"low data {'on' if s.get('lowdata') else 'off'}"]
    if s.get("lowdata_apps"):
        parts.append("freeze " + ", ".join(s["lowdata_apps"]))
    if s.get("lowdata_throttle"):
        parts.append(f"throttle {', '.join(s['lowdata_throttle'])} "
                     f"to {s.get('throttle_pct', 25)}%")
    if s.get("burst_cap_mb"):
        parts.append(f"burst cap {s['burst_cap_mb']} MB/min")
    return ", ".join(parts)


def profile_cmd(action, name):
    """`netmeter profile` lists, `netmeter profile rm NAME` forgets one."""
    cfg = load_config()
    profiles = cfg.get("network_profiles") or {}
    if action == "rm":
        if not name:
            print("Usage: netmeter profile rm NAME")
            return
        keep = {m: p for m, p in profiles.items() if p.get("name") != name}
        if len(keep) == len(profiles):
            print(f"No profile named '{name}'.")
            return
        update_config(network_profiles=keep)
        print(f"Forgot profile '{name}'. If it is applied right now it stays "
              f"applied until you leave the network.")
        return
    if not profiles:
        print("No network profiles. Set the modes how you want them, then run "
              "`netmeter profile-here NAME` while on the network.")
        return
    _, gw = gateway_mac(cfg.get("wifi_if", "en0"))
    stint = read_json(PROFILE_PATH) or {}
    for mac, prof in sorted(profiles.items(), key=lambda kv: kv[1].get("name", "")):
        marks = [m for m, on in (("here now", mac == gw),
                                 ("applied", stint.get("mac") == mac)) if on]
        tail = f"  [{', '.join(marks)}]" if marks else ""
        print(f"{prof.get('name', '?')}  (MAC {mac}): "
              f"{profile_summary(prof.get('settings') or {})}{tail}")


def notify(text):
    subprocess.run(["osascript", "-e",
                    f'display notification "{text}" with title "netmeter"'],
                   capture_output=True)


def run_daemon(interval, ticks=None):
    """Stream `nettop -d`: each sample after the first reports per-interval deltas
    per process, so no baseline arithmetic is needed. (Per-process cumulative
    counters are NOT monotonic — they drop when sockets close — so computing our
    own deltas double-counted traffic.)"""
    state = {"date": None, "data": None, "notified_mb": None,
             "bucket_min": None, "bucket": {}, "capped": set(), "appends": 0}
    blocks_done = 0
    throttle_stop = start_throttle_worker()

    def handle_block(rows):
        nonlocal blocks_done
        today = datetime.date.today().isoformat()
        if today != state["date"]:
            state["date"] = today
            state["data"] = load(today)
            if state["data"]["started"] is None:
                state["data"]["started"] = datetime.datetime.now().isoformat(timespec="seconds")
        data = state["data"]
        now_ts = time.time()
        tick_in = tick_out = 0
        active = set()
        for line in rows:
            row = parse_row(line)
            if row is None:
                continue
            name, d_in, d_out = row
            # nettop occasionally emits a negative interval delta when a
            # counter resets mid-sample. Summed as-is it walks the daily totals
            # backwards, so clamp rather than trust it. (Seen 2026-08-19:
            # syspolicyd reported [0, -28].)
            d_in, d_out = max(0, d_in), max(0, d_out)
            if d_in or d_out:
                label = friendly(name)
                t = data["apps"].setdefault(label, [0, 0])
                t[0] += d_in
                t[1] += d_out
                tick_in += d_in
                tick_out += d_out
                active.add(label)
                b = state["bucket"].setdefault(label, [0, 0])
                b[0] += d_in
                b[1] += d_out

        # Close the minute bucket when the clock rolls over, so the history file
        # is appended to once a minute rather than on every tick.
        minute = int(now_ts // 60)
        if state["bucket_min"] is None:
            state["bucket_min"] = minute
        elif minute != state["bucket_min"]:
            append_recent(state["bucket_min"], state["bucket"])
            state["bucket_min"], state["bucket"] = minute, {}
            state["capped"] = set()
            state["appends"] += 1
            if state["appends"] % 60 == 0:
                prune_recent()
        data["updated"] = datetime.datetime.now().isoformat(timespec="seconds")
        save_json(state_path(today), data)

        sess_apps, sess_started = session_totals(data)
        s_in = sum(v[0] for v in sess_apps.values())
        s_out = sum(v[1] for v in sess_apps.values())
        # nettop's deltas cover exactly one -s interval, so that is the right divisor.
        elapsed = max(interval, 0.001)
        cfg = load_config()

        # Tether cap accounting: raw interface bytes (headers included, so it
        # tracks what the carrier bills), counted only while the gateway MAC
        # matches a linked tether network.
        iface = cfg.get("wifi_if", "en0")
        _, gw_mac = gateway_mac(iface)
        macs = cfg.get("tether_gateway_macs") or []
        tether_on = gw_mac is not None and gw_mac in macs
        wb = wifi_bytes(iface)
        prev = state.get("wifi_prev")
        state["wifi_prev"] = wb
        tether = load_tether(cfg)
        if tether_on and wb and prev:
            t_in = wb[0] - prev[0] if wb[0] >= prev[0] else wb[0]
            t_out = wb[1] - prev[1] if wb[1] >= prev[1] else wb[1]
            tether["in"] += t_in
            tether["out"] += t_out
            cap = cfg.get("tether_cap_gb", 0) * GB
            if cap:
                pct = 100 * (tether["in"] + tether["out"]) / cap
                for mark in (50, 75, 90, 100):
                    if pct >= mark and tether.get("notified_pct", 0) < mark:
                        tether["notified_pct"] = mark
                        notify(f"{cfg.get('tether_name', 'tether')}: "
                               f"{fmt(tether['in'] + tether['out'])} of "
                               f"{cfg.get('tether_cap_gb')} GB used ({mark}%)")
            save_json(TETHER_PATH, tether)

        # Per-network profiles ride the same MAC read as the tether counter.
        # Wrapped hard: a profile bug must never take the sampler down with it,
        # and a failed check just means this tick behaves like the last one.
        try:
            if profile_check(cfg, gw_mac):
                cfg = load_config()   # the profile just rewrote config
        except Exception as e:
            print(f"netmeter: profile check failed: {e}")

        save_json(NOW_PATH, {
            "ts": now_ts,
            "down_bps": tick_in / elapsed,
            "up_bps": tick_out / elapsed,
            "session_in": s_in,
            "session_out": s_out,
            "session_started": sess_started,
            "tether_name": cfg.get("tether_name", ""),
            "tether_used": tether["in"] + tether["out"],
            "tether_cap_gb": cfg.get("tether_cap_gb", 0),
            "tether_on": tether_on,
            "tether_setup": bool(macs),
            # The bar's "always Low Data here" row needs to know which network
            # it is standing on; the profile lookup itself stays in config.json.
            "net_mac": gw_mac or "",
            "tether_resets": tether_next_reset(
                datetime.date.fromisoformat(tether["period_start"])).isoformat(),
        })
        if cfg["solo"]:
            for name in solo_freeze(cfg, active):
                notify(f"Solo mode froze {name} ({cfg['solo_app']} only)")
        if cfg["lowdata"]:
            for app in cfg["lowdata_apps"]:
                signal_app(app, signal.SIGSTOP)
            cap = cfg.get("burst_cap_mb") or 0
            if cap:
                for name, moved in burst_cap_check(state["bucket"], cap, state["capped"]):
                    notify(f"Froze {name}: {fmt(moved)} in under a minute "
                           f"(cap {cap} MB). Resume with: netmeter resume {name}")
            step = cfg.get("notify_every_mb") or 0
            if step:
                total_mb = (s_in + s_out) / MB
                if state["notified_mb"] is None:
                    state["notified_mb"] = (total_mb // step) * step
                elif total_mb >= state["notified_mb"] + step:
                    state["notified_mb"] = (total_mb // step) * step
                    notify(f"Session has used {total_mb:.0f} MB")
        else:
            state["notified_mb"] = None
        blocks_done += 1

    try:
        while ticks is None or blocks_done < ticks:
            cmd = ["nettop", "-P", "-x", "-d", "-s", str(max(1, int(interval))),
                   "-L", "0" if ticks is None else str(ticks + 1),
                   "-J", "bytes_in,bytes_out"]
            # Run under a pty (`script`), else nettop block-buffers and samples arrive bunched.
            proc = subprocess.Popen(["script", "-q", "/dev/null"] + cmd,
                                    stdout=subprocess.PIPE, text=True)
            block_idx = 0
            pending = []
            try:
                for line in proc.stdout:
                    if line.startswith(","):  # header row marks the start of a sample
                        if block_idx > 1 and pending:  # block 1 is cumulative; skip it
                            handle_block(pending)
                            if ticks is not None and blocks_done >= ticks:
                                proc.kill()
                                break
                        block_idx += 1
                        pending = []
                    else:
                        pending.append(line)
                else:
                    # nettop exited: flush the final block on bounded runs, then respawn/stop
                    if ticks is not None and block_idx > 1 and pending and blocks_done < ticks:
                        handle_block(pending)
            finally:
                proc.kill()
                proc.wait()
            if ticks is None:
                time.sleep(interval)  # nettop died; breathe before respawning
    finally:
        throttle_stop.set()
        unfreeze_throttled()


def fmt(b):
    if b >= GB:
        return f"{b / GB:.2f} GB"
    if b >= MB:
        return f"{b / MB:.0f} MB"
    return f"{b / KB:.0f} KB"


def print_table(apps, header):
    rows = sorted(apps.items(), key=lambda kv: kv[1][0] + kv[1][1], reverse=True)
    tot_in = sum(v[0] for v in apps.values())
    tot_out = sum(v[1] for v in apps.values())
    width = max([len(name) for name, _ in rows] + [len("TOTAL")])
    print(header)
    print(f"{'APP':<{width}}  {'DOWN':>10}  {'UP':>10}  {'TOTAL':>10}")
    for name, (b_in, b_out) in rows:
        if b_in + b_out < 10 * 1024:  # hide sub-10KB noise
            continue
        print(f"{name:<{width}}  {fmt(b_in):>10}  {fmt(b_out):>10}  {fmt(b_in + b_out):>10}")
    print(f"{'TOTAL':<{width}}  {fmt(tot_in):>10}  {fmt(tot_out):>10}  {fmt(tot_in + tot_out):>10}")


def show(date):
    data = load(date)
    if not data["apps"]:
        print(f"No data recorded for {date}. Is the daemon running?")
        print("  launchctl list | grep netmeter   # check")
        return
    print_table(data["apps"],
                f"netmeter — {date}  (recording since {data['started']}, updated {data['updated']})")
    if date == datetime.date.today().isoformat():
        sess_apps, started = session_totals(data)
        s_in = sum(v[0] for v in sess_apps.values())
        s_out = sum(v[1] for v in sess_apps.values())
        print(f"\nSession since {started}: ↓{fmt(s_in)} ↑{fmt(s_out)} "
              f"(total {fmt(s_in + s_out)}) — `netmeter session` for the breakdown")


def fmt_window(minutes):
    if minutes < 60:
        return f"{minutes}m"
    h, m = divmod(minutes, 60)
    return f"{h}h" if not m else f"{h}h {m}m"


def show_recent(minutes):
    apps = read_recent(minutes)
    if not apps:
        print(f"No traffic recorded in the last {fmt_window(minutes)}. "
              "The history only starts when the daemon does.")
        return
    rows = sorted(apps.items(), key=lambda kv: kv[1][0] + kv[1][1], reverse=True)
    total = sum(v[0] + v[1] for v in apps.values())
    width = max([len(n) for n, _ in rows[:12]] + [len("TOTAL")])
    print(f"netmeter, last {fmt_window(minutes)}  (total {fmt(total)}, "
          f"{fmt(total / (minutes * 60))}/s average)")
    for name, (b_in, b_out) in rows[:12]:
        both = b_in + b_out
        share = both / total if total else 0
        bar = "#" * max(1, round(share * 24))
        print(f"{name:<{width}}  {fmt(both):>10}  {100 * share:4.0f}%  {bar}")


def show_session():
    data = load(datetime.date.today().isoformat())
    apps, started = session_totals(data)
    if not apps:
        print("No session traffic yet.")
        return
    print_table(apps, f"netmeter session — since {started}")


def main():
    p = argparse.ArgumentParser(prog="netmeter")
    sub = p.add_subparsers(dest="cmd")
    sp = sub.add_parser("start", help="run the sampling daemon")
    sp.add_argument("--interval", type=float, default=5.0)
    sp.add_argument("--ticks", type=int, default=None, help="stop after N samples (for testing)")
    shp = sub.add_parser("show", help="show a specific day")
    shp.add_argument("date")
    sep = sub.add_parser("session", help="show the session, or reset it")
    sep.add_argument("action", nargs="?", choices=["reset"])
    for name in ("pause", "resume", "status"):
        ap = sub.add_parser(name)
        ap.add_argument("app")
    thp = sub.add_parser("throttle", help="slow an app instead of freezing it")
    thp.add_argument("app", nargs="?", help="app name or alias, or `off` for all")
    thp.add_argument("state", nargs="?", choices=["off"], help="lift this app's throttle")
    thp.add_argument("--pct", type=int, help="percent of full speed (default 25)")
    lp = sub.add_parser("lowdata", help="low data mode on/off")
    lp.add_argument("action", nargs="?", choices=["on", "off"])
    php = sub.add_parser("profile-here",
                         help="pin the current lowdata settings to this network")
    php.add_argument("name")
    pfp = sub.add_parser("profile", help="list per-network profiles; `profile rm NAME` forgets one")
    pfp.add_argument("action", nargs="?", choices=["list", "rm"])
    pfp.add_argument("name", nargs="?")
    slp = sub.add_parser("solo", help="only APP may use the network; `solo off` lifts it")
    slp.add_argument("app", nargs="?", help="app name or alias, or `off`")
    dp = sub.add_parser("display", help="menu bar display options")
    dp.add_argument("--combine", choices=["on", "off"],
                    help="show one combined rate instead of separate down and up")
    dp.add_argument("--rate", choices=["on", "off"], help="show the live transfer speed")
    dp.add_argument("--total", choices=["on", "off"], help="show the session total")
    dp.add_argument("--recent-window", type=int, dest="recent_window",
                    help="minutes covered by the recent-usage table")
    dp.add_argument("--recent-open", choices=["on", "off"], dest="recent_open",
                    help="expand or collapse the recent-usage table")
    rcp = sub.add_parser("recent", help="per-app usage over a recent window")
    rcp.add_argument("minutes", nargs="?", type=int, default=60)
    sub.add_parser("resume-all", help="unfreeze every paused app")
    tp = sub.add_parser("tether", help="metered-network status; pass GB to seed the period")
    tp.add_argument("used_gb", nargs="?", type=float)
    tcp = sub.add_parser("tether-config", help="set the metered network's name, cap, reset day")
    tcp.add_argument("--name")
    tcp.add_argument("--cap", type=float, help="GB per billing month")
    tcp.add_argument("--reset-day", type=int, dest="reset_day", help="day of month the cap resets")
    tcp.add_argument("--notify-every-mb", type=int, dest="notify_mb", help="low data mode interval")
    tcp.add_argument("--combine", choices=["on", "off"],
                     help="menu bar: one combined rate instead of separate down and up")
    tcp.add_argument("--rate", choices=["on", "off"], help="menu bar: show the live speed")
    tcp.add_argument("--total", choices=["on", "off"], help="menu bar: show the session total")
    sub.add_parser("tether-here", help="link the current wi-fi network as the metered one")
    sub.add_parser("tether-forget", help="unlink all metered networks")
    sub.add_parser("reset", help="zero out today's counters and the session")
    args = p.parse_args()

    if args.cmd == "start":
        try:
            run_daemon(args.interval, args.ticks)
        except KeyboardInterrupt:
            pass
    elif args.cmd == "show":
        show(args.date)
    elif args.cmd == "session":
        reset_session() if args.action == "reset" else show_session()
    elif args.cmd == "pause":
        pause(args.app)
    elif args.cmd == "resume":
        resume(args.app)
    elif args.cmd == "status":
        status(args.app)
    elif args.cmd == "throttle":
        throttle(args.app, 0 if args.state == "off" else args.pct)
    elif args.cmd == "lowdata":
        lowdata(args.action)
    elif args.cmd == "profile-here":
        profile_here(args.name)
    elif args.cmd == "profile":
        profile_cmd(args.action, args.name)
    elif args.cmd == "solo":
        solo(args.app)
    elif args.cmd == "display":
        changes = {}
        if args.combine is not None:
            changes["combine_updown"] = args.combine == "on"
        if args.rate is not None:
            changes["show_rate"] = args.rate == "on"
        if args.total is not None:
            changes["show_total"] = args.total == "on"
        if args.recent_window is not None:
            changes["recent_window"] = max(1, min(720, args.recent_window))
        if args.recent_open is not None:
            changes["recent_open"] = args.recent_open == "on"
        cfg = update_config(**changes) if changes else load_config()
        shown = []
        if cfg["show_rate"]:
            shown.append("one combined rate (\u21c5)" if cfg["combine_updown"]
                         else "separate \u2193 and \u2191")
        if cfg["show_total"]:
            shown.append("session total")
        print("Menu bar: " + (", ".join(shown) if shown
                              else "arrow only (\u21c5), both readouts hidden"))
    elif args.cmd == "recent":
        show_recent(args.minutes)
    elif args.cmd == "resume-all":
        resume_all()
    elif args.cmd == "tether-config":
        changes = {}
        if args.name is not None:
            changes["tether_name"] = args.name
        if args.cap is not None:
            changes["tether_cap_gb"] = args.cap
        if args.reset_day is not None:
            changes["tether_reset_day"] = max(1, min(28, args.reset_day))
        if args.notify_mb is not None:
            changes["notify_every_mb"] = args.notify_mb
        if args.combine is not None:
            changes["combine_updown"] = args.combine == "on"
        if args.rate is not None:
            changes["show_rate"] = args.rate == "on"
        if args.total is not None:
            changes["show_total"] = args.total == "on"
        cfg = update_config(**changes)
        print(f"Metered network: {cfg.get('tether_name') or '(unnamed)'} · "
              f"{cfg.get('tether_cap_gb') or 0} GB/month · resets on day "
              f"{cfg.get('tether_reset_day', 1)}. Link the network itself with "
              f"`netmeter tether-here` while connected to it.")
    elif args.cmd == "tether-forget":
        update_config(tether_gateway_macs=[])
        print("Unlinked all metered networks.")
    elif args.cmd == "tether":
        cfg = load_config()
        if not cfg.get("tether_name") and not cfg.get("tether_cap_gb"):
            print("No metered network configured. Set one with:")
            print("  netmeter tether-config --name <network> --cap <GB> --reset-day <day>")
            print("  netmeter tether-here   (run once while connected to it)")
            return
        t = load_tether(cfg)
        if args.used_gb is not None:
            t["in"], t["out"], t["notified_pct"] = int(args.used_gb * GB), 0, 0
            save_json(TETHER_PATH, t)
            print(f"Seeded the period at {args.used_gb} GB.")
        used = t["in"] + t["out"]
        cap_gb = cfg.get("tether_cap_gb", 0)
        nr = tether_next_reset(datetime.date.fromisoformat(t["period_start"]))
        days = (nr - datetime.date.today()).days
        _, gw = gateway_mac(cfg.get("wifi_if", "en0"))
        macs = cfg.get("tether_gateway_macs") or []
        if not macs:
            state_txt = "not linked yet: run `netmeter tether-here` while tethered"
        elif gw in macs:
            state_txt = "connected, counting"
        else:
            state_txt = "not on the tether network"
        pct = f" ({100 * used / (cap_gb * GB):.0f}%)" if cap_gb else ""
        print(f"{cfg.get('tether_name')}: {fmt(used)} of {cap_gb} GB{pct} · "
              f"resets {nr.isoformat()} ({days} days) · {state_txt}")
    elif args.cmd == "tether-here":
        cfg = load_config()
        ip, gw = gateway_mac(cfg.get("wifi_if", "en0"))
        if not gw:
            print("Could not read the gateway MAC. Are you on wi-fi?")
        else:
            macs = cfg.get("tether_gateway_macs") or []
            if gw not in macs:
                macs.append(gw)
            cfg = update_config(tether_gateway_macs=macs)
            print(f"Linked this network (router {ip}, MAC {gw}) as "
                  f"{cfg.get('tether_name')}. Its traffic now counts against the "
                  f"{cfg.get('tether_cap_gb')} GB cap.")
    elif args.cmd == "reset":
        today = datetime.date.today().isoformat()
        for path in (state_path(today), SESSION_PATH):
            try:
                os.remove(path)
            except FileNotFoundError:
                pass
        print(f"Reset counters and session for {today}.")
    else:
        show(datetime.date.today().isoformat())


if __name__ == "__main__":
    main()
